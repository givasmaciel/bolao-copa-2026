<%- include('partials/header', { active: 'admin' }) %>

<%- include('partials/flash') %>

<h1>👥 Gerenciar participantes</h1>
<p class="subtitulo">Crie, promova ou exclua contas de participantes.</p>

<div class="card mb-3" style="border-left:4px solid var(--verde)">
  <h3 style="margin-top:0">➕ Criar novo participante</h3>
  <form method="POST" action="/admin/usuarios/criar" class="grid grid-4" style="align-items:end">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group" style="margin:0">
      <label for="nome">Nome</label>
      <input type="text" id="nome" name="nome" class="form-control" required>
    </div>
    <div class="form-group" style="margin:0">
      <label for="username">Usuário</label>
      <input type="text" id="username" name="username" class="form-control" placeholder="opcional">
    </div>
    <div class="form-group" style="margin:0">
      <label for="email">E-mail</label>
      <input type="email" id="email" name="email" class="form-control" required>
    </div>
    <div class="form-group" style="margin:0">
      <label for="senha">Senha</label>
      <input type="text" id="senha" name="senha" class="form-control" required minlength="4" placeholder="mín. 4 caracteres">
    </div>
    <div>
      <button type="submit" class="btn btn-primary">➕ Criar</button>
    </div>
  </form>
</div>

<table class="ranking-tabela">
  <thead>
    <tr>
      <th>Nome</th>
      <th>Usuário</th>
      <th>E-mail</th>
      <th class="text-center">Admin</th>
      <th class="text-center">Bônus</th>
      <th class="text-center">Desde</th>
      <th class="text-center">Ações</th>
    </tr>
  </thead>
  <tbody>
    <% usuarios.forEach(function(u) { %>
      <tr>
        <td>
          <div style="display:flex;align-items:center;gap:8px">
            <img src="/foto/<%= u.id %>" alt="" class="avatar-sm" onerror="this.outerHTML='<span style=font-size:1rem>👤</span>'">
            <%= u.nome %>
          </div>
        </td>
        <td style="font-family:monospace"><%= u.username || '—' %></td>
        <td><%= u.email %></td>
        <td class="text-center" style="white-space:nowrap">
          <% if (u.is_admin) { %>
            <span title="Admin: tem poderes de gestão e participa do bolão">🎮 Admin</span>
          <% } else { %>
            <span style="color:var(--text-muted)">👤</span>
          <% } %>
        </td>
        <td class="text-center">
          <%= u.total_bonus > 0 ? '+' + u.total_bonus : '0' %>
          <details style="display:inline-block;vertical-align:middle">
            <summary class="btn btn-sm btn-secondary" style="cursor:pointer;font-size:0.7rem;padding:2px 6px">+</summary>
            <div style="position:absolute;background:var(--card-bg);border:1px solid var(--border);padding:8px;border-radius:8px;z-index:10;margin-top:4px;min-width:240px;right:0">
              <form method="POST" action="/admin/usuarios/<%= u.id %>/bonus" style="display:flex;flex-direction:column;gap:4px">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div style="display:flex;gap:4px">
                  <input type="number" name="pontos" placeholder="Pontos" min="1" required class="form-control" style="width:80px">
                  <input type="text" name="motivo" placeholder="Motivo" class="form-control" style="flex:1">
                  <button type="submit" class="btn btn-sm btn-primary">Dar</button>
                </div>
              </form>
              <% if (bonusMap[u.id] && bonusMap[u.id].length > 0) { %>
                <hr style="margin:4px 0">
                <div style="font-size:0.7rem;max-height:100px;overflow-y:auto">
                  <% bonusMap[u.id].forEach(function(b) { %>
                    <div style="display:flex;justify-content:space-between;gap:4px;padding:2px 0">
                      <span>+<%= b.pontos %><%= b.motivo ? ' (' + b.motivo + ')' : '' %></span>
                      <div style="display:flex;gap:4px">
                        <details style="display:inline-block">
                          <summary style="background:none;border:none;color:var(--azul);cursor:pointer;padding:0;font-size:0.7rem;">✎</summary>
                          <div style="position:absolute;background:var(--card-bg);border:1px solid var(--border);padding:8px;border-radius:8px;z-index:11;margin-top:4px;right:0">
                            <form method="POST" action="/admin/usuarios/<%= u.id %>/bonus/<%= b.id %>/editar" style="display:flex;flex-direction:column;gap:4px;min-width:200px">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                              <input type="number" name="pontos" value="<%= b.pontos %>" min="1" required class="form-control" placeholder="Pontos">
                              <input type="text" name="motivo" value="<%= b.motivo || '' %>" class="form-control" placeholder="Motivo">
                              <button type="submit" class="btn btn-sm btn-primary">Salvar</button>
                            </form>
                          </div>
                        </details>
                        <form method="POST" action="/admin/usuarios/<%= u.id %>/bonus/<%= b.id %>/remover" style="display:inline">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" style="background:none;border:none;color:var(--erro);cursor:pointer;padding:0;font-size:0.7rem;">✕</button>
                        </form>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% } %>
            </div>
          </details>
        </td>
        <td class="text-center"><%= new Date(u.criado_em).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %></td>
        <td class="text-center" style="white-space:nowrap">
          <details style="display:inline-block;vertical-align:middle">
            <summary class="btn btn-sm btn-secondary" style="cursor:pointer">👤 Usuário</summary>
            <div style="position:absolute;background:var(--card-bg);border:1px solid var(--border);padding:8px;border-radius:8px;z-index:10;margin-top:4px">
              <form method="POST" action="/admin/usuarios/<%= u.id %>/alterar-username" style="display:flex;gap:4px">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="text" name="username" value="<%= u.username || '' %>" placeholder="nome de usuário" class="form-control" style="width:130px">
                <button type="submit" class="btn btn-sm btn-primary">Salvar</button>
              </form>
            </div>
          </details>
          <details style="display:inline-block;vertical-align:middle">
            <summary class="btn btn-sm btn-secondary" style="cursor:pointer">🔑 Senha</summary>
            <div style="position:absolute;background:var(--card-bg);border:1px solid var(--border);padding:8px;border-radius:8px;z-index:10;margin-top:4px">
              <form method="POST" action="/admin/usuarios/<%= u.id %>/resetar-senha" style="display:flex;gap:4px">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="password" name="nova_senha" placeholder="Nova senha" minlength="4" required class="form-control" style="width:140px">
                <button type="submit" class="btn btn-sm btn-primary">Salvar</button>
              </form>
            </div>
          </details>
          <% if (!u.is_admin) { %>
            <form method="POST" action="/admin/usuarios/<%= u.id %>/tornar-admin" style="display:inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-sm btn-amarelo" onclick="return confirm('Promover <%= u.nome %> a admin?\n\nOs pontos do participante são preservados e ele continua no bolão.')">Tornar admin</button>
            </form>
          <% } else { %>
            <form method="POST" action="/admin/usuarios/<%= u.id %>/rebaixar" style="display:inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-sm btn-secondary" onclick="return confirm('Rebaixar <%= u.nome %> para participante?\n\nEle continua no bolão, mas perde acesso ao /admin.')">Rebaixar</button>
            </form>
          <% } %>
          <form method="POST" action="/admin/usuarios/<%= u.id %>/resetar-palpites" style="display:inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-sm btn-secondary" onclick="return confirm('Resetar TODOS os palpites de <%= u.nome %>?')">Resetar palpites</button>
          </form>
          <form method="POST" action="/admin/usuarios/<%= u.id %>/excluir" style="display:inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-sm" style="background:var(--erro);color:white" onclick="return confirmarExclusao(event, '<%= u.nome.replace(/'/g, "\\'") %>', this.form)">Excluir</button>
          </form>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>

<p class="texto-aux mt-2">
  <a href="/admin">← Voltar ao painel</a>
</p>

<!-- Modal de confirmação de exclusão -->
<div id="modal-excluir" class="modal-overlay" style="display:none">
  <div class="modal-box">
    <h3 style="margin:0 0 8px 0;color:var(--erro)">⚠️ Excluir participante?</h3>
    <p style="margin:0 0 12px 0;color:var(--text-muted);font-size:0.9rem">
      Esta ação é <strong>irreversível</strong> e remove todos os palpites do usuário.
    </p>
    <p style="margin:0 0 12px 0;font-size:0.9rem">
      Digite <strong id="modal-excluir-nome-esperado"></strong> para confirmar:
    </p>
    <input type="text" id="modal-excluir-input" placeholder="Nome do usuário" autocomplete="off" style="width:100%;padding:8px;border:1px solid var(--border-soft);border-radius:6px;font-size:0.95rem">
    <div style="display:flex;gap:8px;margin-top:14px;justify-content:flex-end">
      <button type="button" class="btn btn-sm btn-secondary" onclick="fecharModalExclusao()">Cancelar</button>
      <button type="button" id="modal-excluir-btn" class="btn btn-sm" style="background:var(--erro);color:white" onclick="executarExclusao()" disabled>Excluir permanentemente</button>
    </div>
  </div>
</div>

<script>
let formParaExcluir = null;
let nomeEsperado = '';

function confirmarExclusao(ev, nome, form) {
  ev.preventDefault();
  formParaExcluir = form;
  nomeEsperado = nome;
  document.getElementById('modal-excluir-nome-esperado').textContent = nome;
  document.getElementById('modal-excluir-input').value = '';
  document.getElementById('modal-excluir-btn').disabled = true;
  document.getElementById('modal-excluir').style.display = 'flex';
  setTimeout(function() { document.getElementById('modal-excluir-input').focus(); }, 50);
  return false;
}

function fecharModalExclusao() {
  document.getElementById('modal-excluir').style.display = 'none';
  formParaExcluir = null;
}

document.addEventListener('DOMContentLoaded', function() {
  const input = document.getElementById('modal-excluir-input');
  const btn = document.getElementById('modal-excluir-btn');
  input.addEventListener('input', function() {
    btn.disabled = input.value.trim() !== nomeEsperado;
  });
  input.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !btn.disabled) { e.preventDefault(); executarExclusao(); }
    if (e.key === 'Escape') { fecharModalExclusao(); }
  });
});

function executarExclusao() {
  if (formParaExcluir) formParaExcluir.submit();
}
</script>

<%- include('partials/footer') %>
