<%- include('partials/header', { active: 'admin' }) %>

<h1>🔗 Link de login automático</h1>
<p class="subtitulo">Esse link faz login automaticamente como administrador. Guarde em local seguro.</p>

<div class="card">
  <p style="word-break:break-all;font-size:1.1rem;background:var(--cinza-claro);padding:16px;border-radius:8px;font-family:monospace">
    <a href="<%= link %>"><%= link %></a>
