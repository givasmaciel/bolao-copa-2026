<%- include('partials/header', { active: 'config' }) %>

<%- include('partials/flash') %>

<h1>⚙️ Minha conta</h1>

<div class="card">
  <h3>Alterar nome</h3>
  <p class="texto-aux">Seu nome aparece no ranking e também serve para fazer login.</p>

  <form method="POST" action="/config/nome" class="form-inline" style="display:flex; gap:8px; align-items:end; flex-wrap:wrap">
    <div class="form-group" style="margin:0;flex:1;min-width:200px">
      <label for="nome">Nome</label>
      <input type="text" id="nome" name="nome" class="form-control" value="<%= usuario.nome %>" placeholder="Seu nome" required>
    </div>
    <button type="submit" class="btn btn-primary">💾 Salvar</button>
  </form>
</div>

<div class="card" style="border-left:4px solid var(--verde)">
  <h3 style="margin-top:0">📨 Convidar amigos</h3>
  <p class="texto-aux">Compartilhe seu código de convite para novos participantes entrarem:</p>
  <div style="font-size:1.4rem;font-family:monospace;background:var(--cinza-claro);padding:12px 16px;border-radius:8px;text-align:center;font-weight:700;letter-spacing:2px"><%= usuario.codigo_convite %></div>
</div>

<div class="card">
  <h3>Suas informações</h3>
  <table style="width:100%">
    <tr><td style="padding:6px 0;font-weight:600;width:120px">Nome:</td><td><%= usuario.nome %></td></tr>
    <tr><td style="padding:6px 0;font-weight:600">E-mail:</td><td><%= usuario.email %></td></tr>
  </table>
</div>

<%- include('partials/footer') %>
