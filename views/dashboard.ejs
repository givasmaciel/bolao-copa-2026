<%- include('partials/header', { active: 'dashboard' }) %>

<%- include('partials/flash') %>

<h1>📊 Painel</h1>

<% if (nextGame) { %>
  <%
    const urgente = !nextGame.jahFechou && nextGame.diffMin <= 120;
    const fechado = nextGame.jahFechou;
    const aberto = !urgente && !fechado;
    const bgStyle = fechado
      ? 'background:linear-gradient(135deg,#fff5f5,#ffe0e0);border-left:4px solid var(--erro)'
      : urgente
        ? 'background:linear-gradient(135deg,#fff8db,#ffe28a);border-left:4px solid #f59e0b;box-shadow:0 4px 16px rgba(245,158,11,.25)'
        : 'background:linear-gradient(135deg,#fffde7,#fef3c7);border-left:4px solid var(--amarelo)';
    const titulo = fechado ? '🔒 JOGO FECHADO' : (urgente ? '⚠️ PALPITE FECHANDO' : '⚽ PRÓXIMO JOGO');
    const tituloCor = fechado ? 'var(--erro)' : (urgente ? '#b45309' : 'var(--verde)');
  %>
  <div class="card" style="<%= bgStyle %>">
    <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap">
      <div style="font-size:2.4rem;<%= urgente ? 'animation:pulse 1.5s infinite' : '' %>"><%= fechado ? '🔒' : (urgente ? '⏰' : '⚽') %></div>
      <div style="flex:1;min-width:240px">
        <div style="font-weight:800;font-size:0.78rem;letter-spacing:1px;color:<%= tituloCor %>;text-transform:uppercase"><%= titulo %></div>
        <div style="font-weight:700;font-size:1.15rem;margin-top:2px">
          <%= nextGame.casa_pt || 'A definir' %> × <%= nextGame.visitante_pt || 'A definir' %>
        </div>
        <div style="font-size:0.82rem;color:var(--cinza-escuro);margin-top:2px">
          📍 <%= nextGame.estadio %>, <%= nextGame.cidade %> &middot; 🕐 <%= nextGame.horaBRT %> (BRT)
        </div>
        <div style="font-size:0.88rem;margin-top:6px">
          <% if (fechado) { %>
            <span style="color:var(--erro);font-weight:600">Fechado para palpites</span>
            <% if (nextGame.temPalpite) { %>
              &middot; Seu palpite: <strong><%= nextGame.palpite_gols_casa %>×<%= nextGame.palpite_gols_visitante %></strong>
            <% } else { %>
              &middot; <span class="texto-aux">Você não palpitou</span>
            <% } %>
          <% } else if (urgente) { %>
            <span style="color:#b45309;font-weight:700">Fecha em <%= nextGame.diffMin %> minutos!</span>
            <% if (!nextGame.temPalpite) { %>
              &middot; <a href="/palpites" style="font-weight:700;color:#b45309;text-decoration:underline">Palpitar agora →</a>
            <% } else { %>
              &middot; Seu palpite: <strong><%= nextGame.palpite_gols_casa %>×<%= nextGame.palpite_gols_visitante %></strong>
            <% } %>
          <% } else { %>
            <span style="color:var(--verde);font-weight:600">✅ Aberto para palpites até <%= nextGame.diffMin %> minutos</span>
            <% if (nextGame.temPalpite) { %>
              &middot; Seu palpite: <strong><%= nextGame.palpite_gols_casa %>×<%= nextGame.palpite_gols_visitante %></strong>
            <% } else { %>
              &middot; <a href="/palpites" style="font-weight:600">Palpitar agora →</a>
            <% } %>
          <% } %>
        </div>
      </div>
    </div>
  </div>
<% } %>

<% if (alertaExtras) { %>
  <div class="card" style="border-left:4px solid var(--amarelo);background:#fffde7;margin-bottom:16px">
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
      <div style="font-size:1.8rem">🏆</div>
      <div style="flex:1">
        <div style="font-weight:700;font-size:1rem">Palpites Extras</div>
        <div style="font-size:0.85rem;margin-top:4px">
          Você ainda não salvou seus palpites extras!
          <% if (extrasDataLimite) { %>
            O prazo encerra em <strong><%= extrasDataLimite.toLocaleString('pt-BR', { dateStyle: 'long', timeStyle: 'short', timeZone: 'America/Sao_Paulo' }) %></strong>.
          <% } %>
        </div>
        <a href="/palpites-extras" class="btn btn-sm btn-primary" style="margin-top:6px">🏆 Fazer palpites extras</a>
      </div>
    </div>
  </div>
<% } %>

<div class="grid grid-4 mb-2">
  <div class="stat-card">
    <div class="stat-valor"><%= stats.total_pontos + extrasPontos + bonusPontos %></div>
    <div class="stat-label">
      Pontos totais
      <% if (bonusPontos > 0) { %>
        <span style="font-size:0.65rem;color:var(--verde)">(+<%= bonusPontos %> bônus)</span>
      <% } %>
      <% if (extrasPontos > 0) { %>
        <span style="font-size:0.65rem;color:var(--cinza-escuro)">(+<%= extrasPontos %> extras)</span>
      <% } %>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-valor"><%= stats.total_palpites %></div>
    <div class="stat-label">Palpites dados</div>
  </div>
  <div class="stat-card">
    <div class="stat-valor"><%= aproveitamento %>%</div>

    <div class="stat-label">Aproveitamento</div>
  </div>
  <div class="stat-card">
    <div class="stat-valor"><%= stats.placares_exatos %></div>
    <div class="stat-label">Placares exatos</div>
  </div>
</div>

<details class="card" style="padding:12px 16px;margin-bottom:16px">
  <summary style="cursor:pointer;font-weight:600;font-size:0.95rem;color:var(--texto)">📋 Pontuação e regras — clique para expandir</summary>

  <div style="padding:14px;background:linear-gradient(135deg,var(--amarelo),var(--verde));color:#fff;text-align:center;border-radius:8px;margin:12px 0">
    <div style="font-size:0.78rem;font-weight:600;letter-spacing:1px;margin-bottom:4px">💰 PREMIAÇÃO 💰</div>
    <div style="display:flex;justify-content:space-around;font-size:0.9rem;flex-wrap:wrap;gap:8px">
      <div><div style="font-size:1.4rem">🥇</div><div style="font-weight:700">R$ <%= parseFloat(premios.premio_1).toFixed(2).replace('.', ',') %></div><div style="font-size:0.65rem;opacity:0.9">1º lugar</div></div>
      <div><div style="font-size:1.2rem">🥈</div><div style="font-weight:700">R$ <%= parseFloat(premios.premio_2).toFixed(2).replace('.', ',') %></div><div style="font-size:0.65rem;opacity:0.9">2º lugar</div></div>
      <div><div style="font-size:1rem">🥉</div><div style="font-weight:700">R$ <%= parseFloat(premios.premio_3).toFixed(2).replace('.', ',') %></div><div style="font-size:0.65rem;opacity:0.9">3º lugar</div></div>
    </div>
  </div>

  <h4 style="margin:12px 0 4px">🏅 Pontuação dos jogos</h4>
  <p class="texto-aux" style="font-size:0.78rem">Os pontos aumentam conforme a fase avança — jogos de mata-mata são mais difíceis de acertar!</p>
  <div style="overflow-x:auto">
  <table class="ranking-tabela" style="font-size:0.78rem;min-width:500px">
    <thead>
      <tr>
        <th>Fase</th>
        <th class="text-center">Placar exato</th>
        <th class="text-center">Empate</th>
        <th class="text-center">Resultado + 1 gol</th>
        <th class="text-center">Só resultado</th>
        <th class="text-center">1 gol certo</th>
        <th class="text-center" title="Bônus por acertar quem classifica quando o jogo vai para prorrogação ou pênaltis">+ Prór.+Pên.<br><span style="font-weight:400;font-size:0.68rem">(½ do Só res.)</span></th>
      </tr>
    </thead>
    <tbody>
      <% pontuacaoFases.forEach(function(f) { %>
        <tr>
          <td><strong><%= faseLabel[f.fase] || f.fase %></strong></td>
          <td class="text-center"><span class="pontos-badge"><%= f.pts_exato %></span></td>
          <td class="text-center"><span class="pontos-badge"><%= f.pts_empate %></span></td>
          <td class="text-center"><span class="pontos-badge"><%= f.pts_resultado_gol %></span></td>
          <td class="text-center"><span class="pontos-badge"><%= f.pts_resultado %></span></td>
          <td class="text-center"><span class="pontos-badge"><%= f.pts_gol %></span></td>
          <td class="text-center">
            <% if (f.fase === 'grupo') { %>
              <span style="color:var(--cinza-escuro)">—</span>
            <% } else { %>
              <span class="pontos-badge" style="background:var(--verde)">+<%= f.pts_classificado %></span>
              <br><span style="font-size:0.7rem;color:var(--cinza-escuro)">½ de <%= f.pts_resultado %></span>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  </div>

  <h4 style="margin:16px 0 4px">📖 O que conta como cada acerto</h4>
  <ul style="font-size:0.78rem;margin:4px 0;padding-left:20px;line-height:1.5">
    <li><strong>Placar exato</strong> — acertou o placar certinho (ex: palpitou 2×1, jogo foi 2×1)</li>
    <li><strong>Empate</strong> — jogo terminou empatado e você palpitou empate (qualquer placar de empate conta)</li>
    <li><strong>Resultado + 1 gol</strong> — acertou quem ganhou/perdeu <em>e</em> o gol de pelo menos um time</li>
    <li><strong>Só resultado</strong> — acertou quem ganhou, mas errou os gols dos dois times</li>
    <li><strong>1 gol certo</strong> — errou quem ganhou, mas acertou o gol de um time</li>
  </ul>

  <h4 style="margin:16px 0 4px">⚡ Mata-mata (prorrogação / pênaltis)</h4>
  <p style="font-size:0.78rem;line-height:1.55;margin:4px 0">
    As regras da fase de grupos continuam valendo igual para o mata-mata: você palpita o placar dos <strong>90 minutos</strong> e pontua normalmente (exato, empate, resultado+gol, etc.).
  </p>
  <p style="font-size:0.78rem;line-height:1.55;margin:4px 0">
    A única diferença é o <strong>bônus "+ Prór.+Pên."</strong>: se o jogo terminar empatado nos 90 min e você acertar <em>quem avançou</em> na prorrogação/pênaltis, ganha a metade do "Só resultado" da fase. <strong>Se o jogo for decidido nos 90 min, esse bônus não se aplica.</strong>
  </p>
  <div style="background:var(--cinza-claro);padding:8px 12px;border-radius:6px;font-size:0.74rem;margin-top:6px;line-height:1.5">
    <strong>💡 Exemplo (quartas):</strong> placar 1×1 (empate) + quem classifica: Brasil → <strong>40</strong> (exato) <strong>+ 8</strong> (classificado) = <strong>48 pts</strong>.
    Se tivesse palpitado outro empate (0×0, 2×2), seriam <strong>28</strong> + <strong>8</strong> = <strong>36 pts</strong>.
  </div>

  <h4 style="margin:16px 0 4px">🏆 Palpites Extras</h4>
  <p style="font-size:0.85rem;margin:4px 0">Você também pode palpitar nos resultados do torneio (categorias independentes — pode escolher um campeão sem tê-lo colocado como finalista):</p>
  <ul style="font-size:0.78rem;margin:4px 0;padding-left:20px;line-height:1.5">
    <li><strong>Campeão</strong> — 200 pts</li>
    <li><strong>Vice-campeão</strong> — 150 pts</li>
    <li><strong>Terceiro lugar</strong> — 100 pts</li>
    <li><strong>Finalista</strong> (2 seleções) — 50 pts cada</li>
    <li><strong>Semifinalistas</strong> (4) — 30 pts cada</li>
    <li><strong>Quartas</strong> (8) — 15 pts cada</li>
    <li><strong>Oitavas</strong> (16) — 10 pts cada</li>
    <li><strong>16 avos</strong> (32) — 5 pts cada</li>
  </ul>

  <h4 style="margin:16px 0 4px">🥇 Critérios de desempate</h4>
  <p style="font-size:0.78rem;margin:4px 0">Quando dois ou mais participantes têm a mesma pontuação, o desempate é feito nesta ordem:</p>
  <ol style="font-size:0.78rem;margin:4px 0;padding-left:20px;line-height:1.5">
    <li>Maior <strong>total de pontos</strong> (jogos finalizados + extras + bônus)</li>
    <li>Maior número de <strong>placares exatos</strong></li>
    <li>Maior número de <strong>resultado + 1 gol certo</strong></li>
    <li>Maior número de <strong>resultados corretos</strong> (sem acertar gol)</li>
    <li>Maior número de <strong>gols acertados</strong> (soma de gols da casa e visitante)</li>
    <li>Maior número de <strong>1 gol certo</strong> (errou quem ganhou, mas acertou gol de 1 time)</li>
    <li>Maior número de <strong>palpites que pontuaram</strong> (&gt; 0)</li>
    <li>Ordem alfabética do nome</li>
  </ol>

  <h4 style="margin:16px 0 4px">📋 Regras gerais</h4>
  <ul style="font-size:0.78rem;margin:4px 0;padding-left:20px;line-height:1.5">
    <li>Os palpites podem ser editados <strong>até 2 minutos antes</strong> do jogo começar.</li>
    <li>Após esse prazo, o palpite daquele jogo é bloqueado.</li>
    <li>Cada jogo vale pontos <strong>uma única vez</strong>, conforme a tabela acima.</li>
    <li>O placar dos jogos é inserido pelo administrador. Os pontos são calculados automaticamente.</li>
    <li><strong>Pontos bônus:</strong> para evitar vantagem ou desvantagem excessiva, participantes que ingressarem após o início da competição iniciam com pontuação igual à do último colocado da rodada de ingresso, reduzida em 1 ponto. Após o encerramento dos palpites extras, não serão aceitas novas inscrições.</li>
    <li><strong>Cadastro encerrado:</strong> não é permitido criar nova conta após o fechamento dos palpites extras.</li>
  </ul>
</details>

<div class="grid grid-2">
  <div class="card">
    <h3 style="margin-top:0">📅 Próximos jogos</h3>
    <% if (proximosJogos.length === 0) { %>
      <p class="texto-aux">Nenhum jogo restante.</p>
    <% } else { %>
      <% proximosJogos.forEach(function(j) { %>
        <% const dataJogo = new Date(j.data); %>
        <% const palpiteLimite = j.palpite_limite ? new Date(j.palpite_limite) : null; %>
        <div class="jogo-card" style="margin-bottom:8px">
          <div class="jogo-time">
            <% if (j.casa_bandeira) { %><img src="<%= j.casa_bandeira %>" alt="" loading="lazy" onerror="flagFallback(this)"><% } %><span><%= j.casa_pt || 'A definir' %></span>
          </div>
          <div class="jogo-info" style="min-width:auto">
            <div style="font-size:0.72rem;color:var(--cinza-escuro)"><%= dataJogo.toLocaleDateString('pt-BR', { weekday:'short', day:'numeric', month:'short', timeZone:'America/Sao_Paulo' }) %> <%= dataJogo.toLocaleTimeString('pt-BR', { hour:'2-digit', minute:'2-digit', timeZone:'America/Sao_Paulo' }) %></div>
            <div style="font-size:0.68rem;color:var(--cinza-escuro)"><%= j.cidade %></div>
            <% if (palpiteLimite) { %>
              <div style="font-size:0.68rem;color:#c0392b;font-weight:bold">Prazo: <%= palpiteLimite.toLocaleTimeString('pt-BR', { hour:'2-digit', minute:'2-digit', timeZone:'America/Sao_Paulo' }) %></div>
            <% } %>
            <% if (j.casa_pt && j.visitante_pt) { %>
              <% if (j.palpite_gols_casa !== null) { %>
                <div class="texto-aux" style="font-size:0.75rem">Seu palpite: <%= j.palpite_gols_casa %>×<%= j.palpite_gols_visitante %></div>
              <% } else { %>
                <a href="/palpites" class="btn btn-sm btn-primary" style="margin-top:4px">⚽ Palpitar</a>
              <% } %>
            <% } else { %>
              <div class="texto-aux" style="font-size:0.75rem">Aguardando definição</div>
            <% } %>
          </div>
          <div class="jogo-time visitante">
            <span><%= j.visitante_pt || 'A definir' %></span><% if (j.visitante_bandeira) { %><img src="<%= j.visitante_bandeira %>" alt="" loading="lazy" onerror="flagFallback(this)"><% } %>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>

  <div>
    <div class="card">
      <h3 style="margin-top:0">🏆 Top 5</h3>
      <table class="ranking-tabela">
        <thead>
          <tr><th>#</th><th>Participante</th><th class="text-center">Pts</th></tr>
        </thead>
        <tbody>
          <% top5.forEach(function(u, idx) { %>
            <tr class="<%= u.id === usuario.id ? 'highlight' : '' %>">
              <td><%= idx + 1 %></td>
              <td>
                <div style="display:flex;align-items:center;gap:6px">
                  <img src="/foto/<%= u.id %>" alt="" class="avatar-sm" onerror="this.outerHTML='<span style=font-size:0.9rem>👤</span>'">
                  <%= u.nome %><%= u.id === usuario.id ? ' (você)' : '' %>
                </div>
              </td>
              <td class="text-center"><strong><%= u.total_pontos %></strong></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <div class="text-center mt-1">
        <a href="/ranking" class="btn btn-sm btn-secondary">Ver ranking completo →</a>
      </div>
    </div>

    <div class="card" style="border-left:4px solid var(--amarelo)">
      <h3 style="margin-top:0">⏳ Palpites pendentes</h3>
      <p style="font-size:1.2rem;font-weight:700;margin:0"><%= pendentes %> jogos</p>
      <p class="texto-aux">faltam ser palpitados</p>
      <a href="/palpites" class="btn btn-primary mt-1 btn-block">⚽ Ir para palpites</a>
    </div>
  </div>
</div>

<% if (recentes && recentes.length > 0) { %>
<div class="card">
  <h3 style="margin-top:0">📋 Últimos resultados</h3>
  <div style="display:flex;flex-direction:column;gap:6px">
    <% recentes.forEach(function(j) { %>
      <% const temPalpite = j.palpite_gols_casa !== null && j.palpite_gols_casa !== undefined; %>
      <div style="display:flex;align-items:center;gap:10px;padding:8px 12px;background:var(--cinza-claro);border-radius:8px;font-size:0.85rem;flex-wrap:wrap">
        <span style="font-weight:600;min-width:80px"><%= j.casa_pt %></span>
        <span style="font-weight:800;color:var(--verde);font-size:1rem"><%= j.gols_casa %>×<%= j.gols_visitante %></span>
        <span style="font-weight:600;min-width:80px"><%= j.visitante_pt %></span>
        <% if (temPalpite) { %>
          <span style="font-size:0.8rem;color:var(--cinza-escuro)">
            Seu: <strong><%= j.palpite_gols_casa %>×<%= j.palpite_gols_visitante %></strong>
          </span>
          <span class="pontos-badge <%= j.pontos_obtidos === 0 ? 'zero' : '' %>" style="font-size:0.7rem">
            <%= j.pontos_obtidos %> pts
          </span>
        <% } else { %>
          <span class="texto-aux" style="font-size:0.75rem">Sem palpite</span>
        <% } %>
      </div>
    <% }); %>
  </div>
</div>
<% } %>

<%- include('partials/footer') %>
