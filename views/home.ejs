<%- include('partials/header', { active: 'home' }) %>

<%- include('partials/flash') %>

<section class="hero">
  <h1>⚽ Bolão da Copa</h1>
  <p style="font-size:0.9rem;color:var(--cinza-escuro);margin-bottom:8px">FIFA 2026 • EUA/MEX/CAN</p>
  <p>Chute o resultado dos <%= totalJogos %> jogos, dispute com a galera e veja quem é o melhor palpiteiro!</p>
  <div class="hero-actions">
    <% if (!usuario) { %>
      <a href="/cadastro" class="btn btn-amarelo btn-lg">Criar minha conta</a>
      <a href="/login" class="btn btn-secondary btn-lg">Já tenho conta</a>
    <% } else { %>
      <a href="/palpites" class="btn btn-amarelo btn-lg">Fazer meus palpites</a>
      <a href="/ranking" class="btn btn-secondary btn-lg">Ver ranking</a>
      <% if (usuario.is_admin) { %>
        <a href="/admin" class="btn btn-primary btn-lg">⚙ Painel admin</a>
      <% } else { %>
        <a href="/palpites" class="btn btn-amarelo btn-lg">Fazer meus palpites</a>
      <% } %>
    <% } %>
  </div>
</section>

<div class="grid grid-4 mb-2">
  <div class="stat-card">
    <div class="stat-valor">48</div>
    <div class="stat-label">Seleções</div>
  </div>
  <div class="stat-card">
    <div class="stat-valor">12</div>
    <div class="stat-label">Grupos (A-L)</div>
  </div>
  <div class="stat-card">
    <div class="stat-valor"><%= totalJogos %></div>
    <div class="stat-label">Jogos no total</div>
  </div>
  <div class="stat-card">
    <div class="stat-valor">3</div>
    <div class="stat-label">Países-sede</div>
  </div>
</div>

<div class="card">
  <h2>Como funciona o bolão</h2>
  <p>É simples: você dá o <strong>placar exato</strong> de cada um dos <%= totalJogos %> jogos. Os pontos aumentam conforme a fase avança — jogos de mata-mata valem mais!</p>

  <% if (pontuacaoFases && pontuacaoFases.length > 0) { %>
  <% const faseLabel = { grupo: 'Fase de Grupos', r32: '16 avos de final', r16: 'Oitavas de final', qf: 'Quartas de final', sf: 'Semifinal', terceiro: 'Disputa de 3º lugar', final: 'Final' }; %>
  <div style="overflow-x:auto">
  <table class="ranking-tabela" style="font-size:0.85rem;min-width:500px">
    <thead>
      <tr>
        <th>Fase</th>
        <th class="text-center">Placar exato</th>
        <th class="text-center">Empate</th>
        <th class="text-center">Resultado + 1 gol</th>
        <th class="text-center">Só resultado</th>
        <th class="text-center">1 gol certo</th>
      </tr>
    </thead>
    <tbody>
      <% pontuacaoFases.forEach(function(f) { %>
        <tr>
          <td><strong><%= faseLabel[f.fase] || f.fase %></strong></td>
          <td class="text-center"><span class="pontos-badge"><%= f.pts_exato %></span></td>
          <td class="text-center"><span class="pontos-badge"><%= f.pts_empate %></span></td>
          <td class="text-center"><span class="pontos-badge"><%= f.pts_resultado_gol %></span></td>
          <td class="text-center"><span class="pontos-badge"><%= f.pts_resultado %></span></td>
          <td class="text-center"><span class="pontos-badge"><%= f.pts_gol %></span></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
  <% } else { %>
  <div class="grid grid-3 mt-2">
      <div class="stat-card" style="border-top-color:#FFD700">
        <div class="stat-valor" style="color:#d4a000">20 pts</div>
        <div class="stat-label">Placar exato</div>
      </div>
      <div class="stat-card" style="border-top-color:#C0C0C0">
        <div class="stat-valor" style="color:#888">14 pts</div>
        <div class="stat-label">Resultado + gols de 1 time</div>
      </div>
      <div class="stat-card" style="border-top-color:#CD7F32">
        <div class="stat-valor" style="color:#a05a2c">14 pts</div>
        <div class="stat-label">Empate (qualquer placar)</div>
      </div>
      <div class="stat-card" style="border-top-color:#6c757d">
        <div class="stat-valor" style="color:#495057">8 pts</div>
        <div class="stat-label">Só resultado (vitória/derrota)</div>
      </div>
      <div class="stat-card" style="border-top-color:#adb5bd">
        <div class="stat-valor" style="color:#6c757d">3 pts</div>
        <div class="stat-label">Errou resultado mas acertou gol de 1 time</div>
      </div>
      <div class="stat-card" style="border-top-color:#dee2e6">
        <div class="stat-valor" style="color:#adb5bd">0 pts</div>
        <div class="stat-label">Errou tudo</div>
      </div>
  </div>
  <% } %>

  <h3 class="mt-3">🏆 Palpites Extras</h3>
  <p>Além dos jogos, você também pode palpitar nos <strong>resultados do torneio</strong>:</p>
  <ul>
    <li><strong>Campeão</strong> — 200 pts</li>
    <li><strong>Vice-campeão</strong> — 150 pts</li>
    <li><strong>Terceiro lugar</strong> — 100 pts</li>
    <li><strong>Finalista</strong> (2 seleções) — 50 pts cada</li>
    <li><strong>Semifinalistas</strong> (4 seleções) — 30 pts cada</li>
    <li><strong>Quartas de final</strong> (8 seleções) — 15 pts cada</li>
    <li><strong>Oitavas de final</strong> (16 seleções) — 10 pts cada</li>
    <li><strong>16 avos de final</strong> (32 seleções) — 5 pts cada</li>
  </ul>
  <p class="texto-aux">Prazo definido pelo administrador. Confira a data exata na página de <a href="/palpites-extras">Palpites Extras</a>.</p>

  <h3 class="mt-3">📋 Regras gerais</h3>
  <ul>
    <li>Os palpites podem ser editados <strong>até 2 minutos antes</strong> do jogo começar.</li>
    <li>Após esse prazo, o palpite daquele jogo é bloqueado.</li>
    <li>Cada jogo vale pontos <strong>uma única vez</strong>, conforme a tabela acima.</li>
    <li>Os jogos do mata-mata (oitavas, quartas, semi, disputa de 3º e final) serão liberados para palpites ao longo do torneio.</li>
    <li>O placar dos jogos é inserido pelo administrador. Os pontos são calculados automaticamente.</li>
    <li>Em caso de empate no ranking, os critérios de desempate (em ordem) são: total de pontos → placares exatos → resultado+gol → resultado → gols certos → 1 gol certo → palpites pontuados → nome. Detalhes no <a href="/ranking">/ranking</a>.</li>
    <li><strong>Pontos bônus:</strong> para evitar vantagem ou desvantagem excessiva, participantes que ingressarem após o início da competição iniciam com pontuação igual à do último colocado da rodada de ingresso, reduzida em 1 ponto. Após o encerramento dos palpites extras, não serão aceitas novas inscrições.</li>
    <li><strong>Cadastro encerrado:</strong> não é permitido criar nova conta após o fechamento dos palpites extras.</li>
  </ul>
</div>

<div class="card">
  <h2>🏆 Os 12 grupos da Copa 2026</h2>
  <div class="grid grid-4 mt-2">
    <% const GRUPOS_HOME = [
      { letra: 'A', times: ['México', 'África do Sul', 'Coreia do Sul', 'Rep. Tcheca'], bandeiras: ['mx','za','kr','cz'] },
      { letra: 'B', times: ['Canadá', 'Bósnia', 'Catar', 'Suíça'], bandeiras: ['ca','ba','qa','ch'] },
      { letra: 'C', times: ['Brasil', 'Marrocos', 'Haiti', 'Escócia'], bandeiras: ['br','ma','ht','gb-sct'] },
      { letra: 'D', times: ['EUA', 'Paraguai', 'Austrália', 'Turquia'], bandeiras: ['us','py','au','tr'] },
      { letra: 'E', times: ['Alemanha', 'Curaçau', 'Costa do Marfim', 'Equador'], bandeiras: ['de','cw','ci','ec'] },
      { letra: 'F', times: ['Holanda', 'Japão', 'Suécia', 'Tunísia'], bandeiras: ['nl','jp','se','tn'] },
      { letra: 'G', times: ['Bélgica', 'Egito', 'Irã', 'Nova Zelândia'], bandeiras: ['be','eg','ir','nz'] },
      { letra: 'H', times: ['Espanha', 'Cabo Verde', 'Arábia Saudita', 'Uruguai'], bandeiras: ['es','cv','sa','uy'] },
      { letra: 'I', times: ['França', 'Senegal', 'Iraque', 'Noruega'], bandeiras: ['fr','sn','iq','no'] },
      { letra: 'J', times: ['Argentina', 'Argélia', 'Áustria', 'Jordânia'], bandeiras: ['ar','dz','at','jo'] },
      { letra: 'K', times: ['Portugal', 'RD Congo', 'Uzbequistão', 'Colômbia'], bandeiras: ['pt','cd','uz','co'] },
      { letra: 'L', times: ['Inglaterra', 'Croácia', 'Gana', 'Panamá'], bandeiras: ['gb-eng','hr','gh','pa'] }
    ]; %>
    <% GRUPOS_HOME.forEach(function(grupo) { %>
      <div class="grupo-bloco">
        <div class="grupo-titulo">
          <div class="grupo-letra"><%= grupo.letra %></div>
          <h3>Grupo <%= grupo.letra %></h3>
        </div>
        <div class="selecoes-lista">
          <% grupo.times.forEach(function(time, idx) { %>
            <div class="selecao-item">
              <img src="https://flagcdn.com/w40/<%= grupo.bandeiras[idx] %>.png" alt="<%= time %>" loading="lazy" onerror="flagFallback(this)">
              <span><%= time %></span>
            </div>
          <% }); %>
        </div>
      </div>
    <% }); %>
  </div>
</div>

<%- include('partials/footer') %>
