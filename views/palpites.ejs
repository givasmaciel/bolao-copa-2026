<%- include('partials/header', { active: 'palpites' }) %>

<%- include('partials/flash') %>

<h1>⚽ Meus palpites</h1>
<p class="subtitulo">Dê o placar dos jogos de <strong>todas as fases</strong>. Você pode editar até <strong>2 minutos antes</strong> do jogo começar (prazo pode ser alterado pelo administrador).</p>

<%
  const palpitesFeitos = stats.total_palpites || 0;
  const totalGlobal = totalJogos || 0;
  const pctProgresso = totalGlobal > 0 ? Math.round((palpitesFeitos / totalGlobal) * 100) : 0;
  const restantes = Math.max(0, totalGlobal - palpitesFeitos);
%>
<div class="progress-palpites">
  <div class="progress-label">
    <span>📊 Progresso dos palpites</span>
    <span><strong><%= palpitesFeitos %></strong> / <%= totalGlobal %> jogos (<%= pctProgresso %>%)</span>
  </div>
  <div class="progress-bar">
    <div class="progress-fill" style="width: <%= pctProgresso %>%"></div>
  </div>
  <% if (restantes > 0) { %>
    <div style="font-size:0.75rem;color:var(--cinza-escuro);margin-top:6px">Faltam <strong><%= restantes %></strong> palpite(s) — continue! ⚽</div>
  <% } else if (totalGlobal > 0) { %>
    <div style="font-size:0.75rem;color:var(--verde);margin-top:6px;font-weight:600">🎉 Você palpitou em todos os jogos!</div>
  <% } %>
</div>

<div class="grid grid-3 mb-2">
  <div class="stat-card">
    <div class="stat-valor"><%= stats.total_palpites %></div>
    <div class="stat-label">Palpites feitos</div>
  </div>
  <div class="stat-card">
    <div class="stat-valor"><%= stats.total_pontos %></div>
    <div class="stat-label">Pontos conquistados</div>
  </div>
  <div class="stat-card">
    <div class="stat-valor"><%= totalGlobal %></div>
    <div class="stat-label">Jogos no total</div>
  </div>
</div>

<% const agora = new Date(); %>

<%
  function contarJogos(arr) {
    var total = 0;
    for (var i = 0; i < arr.length; i++) total += arr[i].jogos.length;
    return total;
  }
  const temAbertos = contarJogos(abertos) > 0;
  const temFechados = contarJogos(fechados) > 0;
  const temFinalizados = contarJogos(finalizados) > 0;
  const temSalvos = stats.total_palpites > 0;

  function renderJogo(jogo, groupId) {
    const dataJogo = new Date(jogo.data);
    const palpiteLimite = jogo.palpite_limite ? new Date(jogo.palpite_limite) : null;
    const margem = palpiteLimite || new Date(dataJogo.getTime() - PALPITE_MARGEM_MS);
    const fechado = agora >= margem;
    const finalizado = jogo.finalizado === 1;
    const temPalpite = jogo.palpite_gols_casa !== null && jogo.palpite_gols_casa !== undefined;
    const pontos = jogo.pontos_obtidos || 0;
%>
    <% if (palpiteLimite) { %>
      <div style="font-size:0.72rem;color:#c0392b;text-align:center;margin-bottom:4px">
        Prazo: <%= palpiteLimite.toLocaleString('pt-BR', { dateStyle:'short', timeStyle:'short', timeZone:'America/Sao_Paulo' }) %>
      </div>
    <% } %>
    <div class="jogo-card <%= finalizado ? 'finalizado' : (fechado ? 'iniciado' : '') %>" data-fecha="<%= margem.toISOString() %>">
      <div class="jogo-time">
        <img src="<%= jogo.casa_bandeira %>" alt="<%= jogo.casa_pt %>">
        <span><%= jogo.casa_pt %></span>
      </div>

      <div class="jogo-info">
        <% if (finalizado) { %>
          <div class="jogo-placar-display">
            <%= jogo.gols_casa %> × <%= jogo.gols_visitante %>
          </div>
          <% if (temPalpite) { %>
            <div class="pontos-badge <%= pontos === 0 ? 'zero' : '' %>">
              <%= pontos %> pts
            </div>
          <% } %>
          <a href="/palpites/jogo/<%= jogo.id %>" class="btn btn-sm btn-secondary" style="font-size:0.7rem;padding:3px 8px;margin-top:4px">📋 Ver palpites</a>
        <% } else if (fechado) { %>
          <div class="jogo-placar-display">? × ?</div>
          <% if (temPalpite) { %>
            <div class="texto-aux" style="font-size:0.72rem">Seu palpite: <strong><%= jogo.palpite_gols_casa %> × <%= jogo.palpite_gols_visitante %></strong></div>
          <% } %>
          <a href="/palpites/jogo/<%= jogo.id %>" class="btn btn-sm btn-secondary" style="font-size:0.7rem;padding:3px 8px;margin-top:4px">📋 Ver palpites</a>
        <% } else { %>
          <form method="POST" action="/palpites/<%= jogo.id %>" class="jogo-form" onsubmit="return salvarIndividual(event, this)">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="jogo-placar">
              <input
                type="number"
                name="casa"
                class="input-grp-<%= groupId %>"
                value="<%= temPalpite ? jogo.palpite_gols_casa : '0' %>"
                min="0" max="99"
                required
              >
              <span class="x">×</span>
              <input
                type="number"
                name="visitante"
                class="input-visit-grp-<%= groupId %>"
                value="<%= temPalpite ? jogo.palpite_gols_visitante : '0' %>"
                min="0" max="99"
                required
              >
            </div>
            <button type="submit" class="btn btn-sm btn-primary salvar-btn" style="margin-top:2px">💾 Salvar</button>
          </form>
        <% } %>
      </div>

      <div class="jogo-time visitante">
        <span><%= jogo.visitante_pt %></span>
        <img src="<%= jogo.visitante_bandeira %>" alt="<%= jogo.visitante_pt %>">
      </div>

      <% const dataFmt = new Date(jogo.data).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short', timeZone: 'America/Sao_Paulo' }); %>
      <div class="jogo-footer">
        <span>📅 <%= dataFmt %></span>
        <span>📍 <%= jogo.estadio %>, <%= jogo.cidade %></span>
        <span>👥 <%= jogo.total_bets %> palpites</span>
        <% if (finalizado) { %><span class="badge badge-finalizado">Final</span><% } else if (fechado) { %><span class="badge badge-pendente">Fechado</span><% } else { %><span class="countdown" data-fecha="<%= margem.toISOString() %>"></span><% } %>
      </div>
    </div>
<% } %>

<% if (temSalvos) { %>
  <%
    // Agrupa palpites salvos por grupo
    const palpitesPorGrupo = {};
    [abertos, fechados, finalizados].forEach(function(cat) {
      for (var g = 0; g < cat.length; g++) {
        var grupo = cat[g];
        if (!palpitesPorGrupo[grupo.label]) palpitesPorGrupo[grupo.label] = { salvos: [], total: 0, label: grupo.label };
        grupo.jogos.forEach(function(j) {
          palpitesPorGrupo[grupo.label].total++;
          if (j.palpite_gols_casa !== null && j.palpite_gols_casa !== undefined) {
            palpitesPorGrupo[grupo.label].salvos.push(j);
          }
        });
      }
    });
    const gruposOrdenados = Object.keys(palpitesPorGrupo);
  %>
  <div class="card" style="border-left:4px solid var(--verde);margin-bottom:20px">
    <div class="flex-between" style="cursor:pointer" onclick="var c=this.nextElementSibling;var i=this.querySelector('.toggle-icon');var h=c.classList.toggle('hidden');i.textContent=h?'▶':'▼'">
      <h3 style="margin:0">✅ Seus palpites salvos</h3>
      <span class="toggle-icon" style="font-size:0.8rem;color:var(--cinza-escuro)">▶</span>
    </div>
    <div class="hidden" style="margin-top:12px">
      <% gruposOrdenados.forEach(function(label) {
        const dados = palpitesPorGrupo[label];
        if (dados.salvos.length === 0) return;
        const preview = dados.salvos.slice(0, 3);
        const restantes = dados.salvos.length - preview.length;
      %>
        <div style="margin-bottom:10px">
          <div style="font-size:0.85rem;font-weight:700;color:var(--azul);display:flex;align-items:center;gap:6px;margin-bottom:4px">
            🏁 <%= label %>
            <span style="background:var(--cinza-claro);color:var(--cinza-escuro);padding:1px 8px;border-radius:10px;font-size:0.7rem;font-weight:600"><%= dados.salvos.length %>/<%= dados.total %></span>
          </div>
          <div style="display:flex;flex-direction:column;gap:3px">
            <% preview.forEach(function(j) { %>
              <div style="display:flex;align-items:center;gap:6px;font-size:0.82rem;padding:3px 8px;background:var(--cinza-claro);border-radius:6px">
                <span style="color:var(--verde);font-weight:700">✔</span>
                <span><%= j.casa_pt %></span>
                <strong style="color:var(--verde)"><%= j.palpite_gols_casa %>×<%= j.palpite_gols_visitante %></strong>
                <span><%= j.visitante_pt %></span>
                <% if (j.finalizado === 1) { %>
                  <span class="pontos-badge <%= (j.pontos_obtidos || 0) === 0 ? 'zero' : '' %>" style="font-size:0.65rem;margin-left:auto"><%= j.pontos_obtidos || 0 %> pts</span>
                <% } %>
              </div>
            <% }); %>
          </div>
          <% if (restantes > 0) { %>
            <button type="button" onclick="var ps=this.parentElement.querySelectorAll('.palpite-restante');ps.forEach(function(p){p.classList.toggle('hidden')});this.textContent=this.textContent.indexOf('Ver')===0?'Ocultar ▴':'Ver mais '+<%= restantes %>+' ▾'" style="margin-top:4px;background:none;border:none;color:var(--azul);font-size:0.78rem;cursor:pointer;padding:2px 0">
              Ver mais <%= restantes %> ▾
            </button>
            <% dados.salvos.slice(3).forEach(function(j) { %>
              <div class="palpite-restante hidden" style="display:flex;align-items:center;gap:6px;font-size:0.82rem;padding:3px 8px;background:var(--cinza-claro);border-radius:6px;margin-top:3px">
                <span style="color:var(--verde);font-weight:700">✔</span>
                <span><%= j.casa_pt %></span>
                <strong style="color:var(--verde)"><%= j.palpite_gols_casa %>×<%= j.palpite_gols_visitante %></strong>
                <span><%= j.visitante_pt %></span>
                <% if (j.finalizado === 1) { %>
                  <span class="pontos-badge <%= (j.pontos_obtidos || 0) === 0 ? 'zero' : '' %>" style="font-size:0.65rem;margin-left:auto"><%= j.pontos_obtidos || 0 %> pts</span>
                <% } %>
              </div>
            <% }); %>
          <% } %>
        </div>
      <% }); %>
    </div>
    <div class="texto-aux mt-1" style="font-size:0.75rem">
      <%= stats.total_palpites %> de <%= totalGlobal %> palpites preenchidos
    </div>
  </div>
<% } %>

<!-- Função helper para gerar id único pro grupo -->
<%
  function groupHtmlId(grupo) {
    return grupo.label.replace(/[\s-]+/g, '-').toLowerCase();
  }
%>

<!-- Seção: Jogos Abertos (palpite disponível) -->
<% if (temAbertos) { %>
<div class="section-group" data-tipo="abertos">
  <% for (var g = 0; g < abertos.length; g++) {
    const grupo = abertos[g];
    const gid = groupHtmlId(grupo);
  %>
    <div class="flex" style="justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
      <h2 class="jogo-rodada-titulo" style="margin:0"><%= grupo.label %></h2>
      <button class="btn btn-sm btn-secondary" onclick="palpitarGrupo('<%= gid %>')" style="font-size:0.8rem">⚡ Preencher todos</button>
      <button class="btn btn-sm btn-primary" onclick="salvarGrupo('<%= gid %>', '<%= grupo.label %>', this)" style="font-size:0.8rem">💾 Salvar todos</button>
    </div>
    <div id="grupo-<%= gid %>-preencher" style="display:none;margin-bottom:8px;background:var(--bg-card);padding:8px;border-radius:8px">
      <form onsubmit="return preencherGrupo(event, '<%= gid %>')" class="flex gap-1" style="align-items:center;flex-wrap:wrap">
        <span style="font-size:0.85rem">Preencher todos com:</span>
        <input type="number" id="grp-casa-<%= gid %>" min="0" max="99" placeholder="0" style="width:50px;padding:4px" required>
        <span class="x">×</span>
        <input type="number" id="grp-visit-<%= gid %>" min="0" max="99" placeholder="0" style="width:50px;padding:4px" required>
        <button type="submit" class="btn btn-sm btn-primary">Aplicar</button>
        <button type="button" class="btn btn-sm btn-secondary" onclick="fecharPreencherGrupo('<%= gid %>')">✕</button>
      </form>
    </div>
    <div class="grupo-jogos" data-grupo="<%= gid %>">
    <% grupo.jogos.forEach(function(jogo) { %>
      <%- renderJogo(jogo, gid) %>
    <% }); %>
    </div>
  <% } %>
</div>
<% } %>

<!-- Seção: Jogos Fechados -->
<% if (temFechados) { %>
<div class="section-group" data-tipo="fechados">
  <div class="flex-between" style="cursor:pointer;margin-top:24px;padding:8px 0" onclick="this.nextElementSibling.classList.toggle('hidden');this.querySelector('.toggle-icon').textContent = this.nextElementSibling.classList.contains('hidden') ? '▶' : '▼'">
    <h2 class="jogo-rodada-titulo" style="margin:0;color:var(--cinza-escuro);font-size:1rem">🔒 Jogos fechados (<%= contarJogos(fechados) %>)</h2>
    <span class="toggle-icon" style="font-size:0.8rem;color:var(--cinza-escuro)">▼</span>
  </div>
  <div>
  <% for (var g = 0; g < fechados.length; g++) {
    const grupo = fechados[g];
  %>
    <div style="margin-top:12px">
      <h3 style="font-size:0.9rem;color:var(--cinza-escuro);margin:0 0 8px 0"><%= grupo.label %></h3>
      <div class="grupo-jogos">
      <% grupo.jogos.forEach(function(jogo) { %>
        <%- renderJogo(jogo, '') %>
      <% }); %>
      </div>
    </div>
  <% } %>
  </div>
</div>
<% } %>

<!-- Seção: Jogos Finalizados -->
<% if (temFinalizados) { %>
<div class="section-group" data-tipo="finalizados">
  <div class="flex-between" style="cursor:pointer;margin-top:24px;padding:8px 0" onclick="this.nextElementSibling.classList.toggle('hidden');this.querySelector('.toggle-icon').textContent = this.nextElementSibling.classList.contains('hidden') ? '▶' : '▼'">
    <h2 class="jogo-rodada-titulo" style="margin:0;color:var(--cinza-escuro);font-size:1rem">🏁 Jogos finalizados (<%= contarJogos(finalizados) %>)</h2>
    <span class="toggle-icon" style="font-size:0.8rem;color:var(--cinza-escuro)">▼</span>
  </div>
  <div>
  <% for (var g = 0; g < finalizados.length; g++) {
    const grupo = finalizados[g];
  %>
    <div style="margin-top:12px">
      <h3 style="font-size:0.9rem;color:var(--cinza-escuro);margin:0 0 8px 0"><%= grupo.label %></h3>
      <div class="grupo-jogos">
      <% grupo.jogos.forEach(function(jogo) { %>
        <%- renderJogo(jogo, '') %>
      <% }); %>
      </div>
    </div>
  <% } %>
  </div>
</div>
<% } %>

<script>
const CSRF_TOKEN = '<%= csrfToken %>';

async function salvarGrupo(gid, label, btn) {
  if (!confirm('Salvar todos os palpites ABERTOS de "' + label + '"?')) return;
  const jogos = {};
  const container = document.querySelector('.grupo-jogos[data-grupo="' + gid + '"]');
  if (!container) { alert('Grupo não encontrado.'); return; }
  const forms = container.querySelectorAll('.jogo-card form');
  forms.forEach(function(form) {
    const action = form.getAttribute('action');
    const match = action.match(/\/palpites\/(\d+)/);
    if (!match) return;
    const jogoId = match[1];
    const casa = form.querySelector('input[name="casa"]')?.value;
    const visitante = form.querySelector('input[name="visitante"]')?.value;
    if (casa !== undefined && visitante !== undefined) {
      jogos[jogoId] = { casa, visitante };
    }
  });
  if (Object.keys(jogos).length === 0) {
    alert('Nenhum jogo aberto neste grupo.');
    return;
  }
  try {
    btn.disabled = true;
    btn.textContent = '⏳ Salvando...';
    const res = await fetch('/palpites/salvar-rodada', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
      body: JSON.stringify({ jogos })
    });
    const data = await res.json();
    if (data.ok) {
      location.reload();
    } else {
      alert(data.erro || 'Erro ao salvar.');
      btn.disabled = false;
      btn.textContent = '💾 Salvar todos';
    }
  } catch (err) {
    alert('Erro ao salvar.');
    btn.disabled = false;
    btn.textContent = '💾 Salvar todos';
  }
}

function atualizarCountdowns() {
  const agora = new Date();
  document.querySelectorAll('.jogo-card[data-fecha]').forEach(function(card) {
    const fecha = new Date(card.getAttribute('data-fecha'));
    const diff = fecha.getTime() - agora.getTime();
    const cd = card.querySelector('.countdown');
    if (!cd) return;
    if (diff <= 0) {
      cd.textContent = '⏰ Fechado!';
      cd.style.color = '#c0392b';
      card.classList.add('iniciado');
      setTimeout(function() { location.reload(); }, 5000);
    } else {
      const h = Math.floor(diff / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      const s = Math.floor((diff % 60000) / 1000);
      cd.textContent = '⏱ Fecha em ' + h + 'h ' + m + 'min ' + s + 's';
    }
  });
}
setInterval(atualizarCountdowns, 1000);
atualizarCountdowns();

function palpitarGrupo(gid) {
  document.getElementById('grupo-' + gid + '-preencher').style.display = 'block';
}

function fecharPreencherGrupo(gid) {
  document.getElementById('grupo-' + gid + '-preencher').style.display = 'none';
}

function salvarIndividual(ev, form) {
  ev.preventDefault();
  const btn = form.querySelector('.salvar-btn');
  btn.disabled = true;
  btn.textContent = '⏳ Salvando...';
  fetch(form.action, {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': CSRF_TOKEN },
    body: new URLSearchParams(new FormData(form))
  }).then(function(r) {
    if (r.redirected) { location.href = r.url; return; }
    location.reload();
  }).catch(function() { location.reload(); });
  return false;
}

function preencherGrupo(ev, gid) {
  ev.preventDefault();
  const casa = document.getElementById('grp-casa-' + gid).value;
  const visit = document.getElementById('grp-visit-' + gid).value;
  if (casa === '' || visit === '') return false;
  document.querySelectorAll('.input-grp-' + gid).forEach(function(inp) { inp.value = casa; });
  document.querySelectorAll('.input-visit-grp-' + gid).forEach(function(inp) { inp.value = visit; });
  fecharPreencherGrupo(gid);
  return false;
}
</script>

<%- include('partials/footer') %>