<%- include('partials/header', { active: 'palpites' }) %>

<%- include('partials/flash') %>

<h1>📋 Palpites do jogo</h1>

<div class="jogo-card <%= jogo.finalizado === 1 ? 'finalizado' : '' %>" style="max-width:500px;margin:0 auto 24px">
  <div class="jogo-time">
    <img src="<%= jogo.casa_bandeira %>" alt=""><span><%= jogo.casa_pt %></span>
  </div>
  <div class="jogo-info">
    <% if (jogo.finalizado === 1) { %>
      <div class="jogo-placar-display"><%= jogo.gols_casa %> × <%= jogo.gols_visitante %></div>
    <% } else { %>
      <div class="jogo-placar-display" style="color:#aaa">×</div>
    <% } %>
    <div class="jogo-data"><%= new Date(jogo.data).toLocaleString('pt-BR', { dateStyle:'short', timeStyle:'short', timeZone:'America/Sao_Paulo' }) %></div>
    <div class="jogo-estadio">📍 <%= jogo.estadio %>, <%= jogo.cidade %></div>
    <% if (jogo.finalizado === 1) { %><span class="badge badge-finalizado" style="margin-top:4px">Final</span><% } %>
  </div>
  <div class="jogo-time visitante">
    <span><%= jogo.visitante_pt %></span><img src="<%= jogo.visitante_bandeira %>" alt="">
  </div>
</div>

<% if (palpites.length === 0) { %>
  <div class="card text-center">
    <p>😕 Ninguém palpitou neste jogo ainda.</p>
  </div>
<% } else { %>
  <div class="card">
    <h3 style="margin-top:0"><%= palpites.length %> palpites</h3>
    <table class="ranking-tabela">
      <thead>
        <tr>
          <th>Participante</th>
          <th class="text-center">Placar</th>
          <% if (jogo.finalizado === 1) { %><th class="text-center">Pontos</th><% } %>
        </tr>
      </thead>
      <tbody>
        <% palpites.forEach(function(p) { %>
          <tr>
            <td><%= p.nome %></td>
            <td class="text-center" style="font-weight:700;font-size:1.1rem">
              <%= p.palpite_gols_casa %> × <%= p.palpite_gols_visitante %>
            </td>
            <% if (jogo.finalizado === 1) { %>
              <td class="text-center">
                <span class="pontos-badge <%= (p.pontos_obtidos || 0) === 0 ? 'zero' : '' %>">
                  <%= p.pontos_obtidos || 0 %>
                </span>
              </td>
            <% } %>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<div class="text-center mt-2">
  <a href="/palpites" class="btn btn-secondary">← Voltar</a>
</div>

<%- include('partials/footer') %>