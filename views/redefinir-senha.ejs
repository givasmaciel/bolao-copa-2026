<%- include('partials/header', { active: 'login' }) %>

<%- include('partials/flash') %>

<div class="auth-container">
  <div class="card">
    <h1>Redefinir senha</h1>
    <p class="subtitulo">Escolha uma nova senha para sua conta.</p>

    <form method="POST" action="/redefinir-senha/<%= token %>">
      <div class="form-row">
        <div class="form-group">
          <label for="senha">Nova senha</label>
          <input type="password" id="senha" name="senha" class="form-control" required minlength="4" placeholder="Mínimo 4 caracteres">
        </div>
        <div class="form-group">
          <label for="confirmar">Confirmar senha</label>
          <input type="password" id="confirmar" name="confirmar" class="form-control" required minlength="4" placeholder="Digite de novo">
        </div>
      </div>
      <button type="submit" class="btn btn-primary btn-block btn-lg">Redefinir senha</button>
    </form>

    <p class="link-aux">
      <a href="/login">Voltar ao login</a>
    </p>
  </div>
</div>

<%- include('partials/footer') %>
