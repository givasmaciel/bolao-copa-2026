<%- include('partials/header', { active: 'resumo' }) %>

<%- include('partials/flash') %>

<h1>📊 Meu resumo</h1>

<div class="card" style="padding:10px">
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(90px,1fr));gap:6px">
    <div class="stat-card" style="padding:8px;border-top-width:2px">
      <div style="font-size:1.3rem;font-weight:800;color:var(--verde);line-height:1.1"><%= stats.total_pontos + extrasPontos + bonusPontos %></div>
      <div style="color:var(--cinza-escuro);font-size:0.65rem;margin-top:2px">
        Pontos
        <% if (bonusPontos > 0) { %><span style="color:var(--verde)">(+<%= bonusPontos %>)</span><% } %>
        <% if (extrasPontos > 0) { %><span style="color:var(--cinza-escuro)">(+<%= extrasPontos %>)</span><% } %>
      </div>
    </div>
    <div class="stat-card" style="padding:8px;border-top-width:2px">
      <div style="font-size:1.3rem;font-weight:800;color:var(--verde);line-height:1.1"><%= stats.total_palpites %></div>
      <div style="color:var(--cinza-escuro);font-size:0.65rem;margin-top:2px">Palpites</div>
    </div>
    <div class="stat-card" style="padding:8px;border-top-width:2px">
      <div style="font-size:1.3rem;font-weight:800;color:var(--verde);line-height:1.1"><%= stats.placares_exatos %></div>
      <div style="color:var(--cinza-escuro);font-size:0.65rem;margin-top:2px">Exato</div>
    </div>
    <div class="stat-card" style="padding:8px;border-top-width:2px">
      <div style="font-size:1.3rem;font-weight:800;color:var(--verde);line-height:1.1"><%= stats.resultados_exatos %></div>
      <div style="color:var(--cinza-escuro);font-size:0.65rem;margin-top:2px">Res+Gol</div>
    </div>
    <div class="stat-card" style="padding:8px;border-top-width:2px">
      <div style="font-size:1.3rem;font-weight:800;color:var(--verde);line-height:1.1"><%= stats.so_resultados %></div>
      <div style="color:var(--cinza-escuro);font-size:0.65rem;margin-top:2px">Só Res</div>
    </div>
    <div class="stat-card" style="padding:8px;border-top-width:2px">
      <div style="font-size:1.3rem;font-weight:800;color:var(--verde);line-height:1.1"><%= stats.acertou_um_gol %></div>
      <div style="color:var(--cinza-escuro);font-size:0.65rem;margin-top:2px">1 Gol</div>
    </div>
    <div class="stat-card" style="padding:8px;border-top-width:2px">
      <div style="font-size:1.3rem;font-weight:800;color:var(--verde);line-height:1.1"><%= stats.errou_tudo %></div>
      <div style="color:var(--cinza-escuro);font-size:0.65rem;margin-top:2px">Errou</div>
    </div>
    <div class="stat-card" style="padding:8px;border-top-width:2px">
      <div style="font-size:1.3rem;font-weight:800;color:var(--verde);line-height:1.1"><%= stats.acertou_empate %></div>
      <div style="color:var(--cinza-escuro);font-size:0.65rem;margin-top:2px">Empate</div>
    </div>
    <div class="stat-card" style="padding:8px;border-top-width:2px">
      <div style="font-size:1.3rem;font-weight:800;color:var(--verde);line-height:1.1"><%= aproveitamento %>%</div>
      <div style="color:var(--cinza-escuro);font-size:0.65rem;margin-top:2px">Aproveit.</div>
    </div>
  </div>
</div>

<div class="card">
  <h3 style="margin-top:0">📈 Pontos por rodada</h3>
  <div style="display:flex;gap:12px;flex-wrap:wrap">
    <% porRodada.forEach(function(r) { %>
      <div style="flex:1;min-width:80px;text-align:center;padding:12px;background:var(--cinza-claro);border-radius:8px">
        <div style="font-size:0.75rem;color:var(--cinza-escuro)">Rodada <%= r.rodada %></div>
        <div style="font-size:1.3rem;font-weight:700;color:var(--verde)"><%= r.pontos %></div>
      </div>
    <% }); %>
  </div>
</div>

<!-- Jogos finalizados -->
<details class="card">
  <summary style="cursor:pointer;list-style:none;display:flex;align-items:center;gap:6px">
    <span class="seta">▶</span>
    <h3 style="margin:0;display:inline">📋 Histórico de jogos finalizados</h3>
    <span class="texto-aux" style="font-size:0.8rem;margin-left:6px">— <%= jogosFinalizados.length %> jogo(s), mais recentes no topo</span>
  </summary>
  <% if (jogosFinalizados.length === 0) { %>
    <p class="texto-aux">Nenhum jogo finalizado ainda.</p>
  <% } else { %>
    <div style="overflow-x:auto">
      <table class="ranking-tabela" style="min-width:500px">
        <thead>
          <tr>
            <th>#</th>
            <th>Jogo</th>
            <th class="text-center">Resultado</th>
            <th class="text-center">Seu palpite</th>
            <th class="text-center">Pontos</th>
          </tr>
        </thead>
        <tbody>
          <% jogosFinalizados.forEach(function(j) { %>
            <tr class="<%= j.pontos_obtidos > 0 ? '' : 'erro' %>">
              <td style="font-size:0.7rem;color:var(--cinza-escuro);white-space:nowrap">
                <% const faseLabelCurto = {grupo: 'G', r32: '16', r16: '8', qf: 'QF', sf: 'SF', terceiro: '3°', final: 'F'}; %>
                <%= faseLabelCurto[j.fase] || j.fase %><%= j.rodada ? '·' + j.rodada : '' %>
              </td>
              <td>
                <span style="display:flex;align-items:center;gap:6px">
                  <% if (j.casa_bandeira) { %><img src="<%= j.casa_bandeira %>" alt="<%= j.casa_pt %>" style="width:18px;height:13px;border-radius:2px" loading="lazy" onerror="flagFallback(this)"><% } %><%= j.casa_pt %>
                  ×
                  <%= j.visitante_pt %><% if (j.visitante_bandeira) { %><img src="<%= j.visitante_bandeira %>" alt="<%= j.visitante_pt %>" style="width:18px;height:13px;border-radius:2px" loading="lazy" onerror="flagFallback(this)"><% } %>
                </span>
              </td>
              <td class="text-center" style="font-weight:700">
                <%= j.gols_casa %> × <%= j.gols_visitante %>
                <% if (j.fase !== 'grupo') { %>
                  <% if (j.gols_casa_pror !== null && j.gols_casa_pror !== undefined) { %>
                    <div style="font-size:0.65rem;color:var(--cinza-escuro);font-weight:400">⏱ <%= j.gols_casa_pror %> × <%= j.gols_visitante_pror %></div>
                  <% } %>
                  <% if (j.placar_penaltis_casa !== null && j.placar_penaltis_casa !== undefined) { %>
                    <div style="font-size:0.65rem;color:var(--cinza-escuro);font-weight:400">🎯 <%= j.placar_penaltis_casa %> × <%= j.placar_penaltis_visitante %></div>
                  <% } %>
                <% } %>
              </td>
              <td class="text-center">
                <% if (j.palpite_gols_casa !== null) { %>
                  <%= j.palpite_gols_casa %> × <%= j.palpite_gols_visitante %>
                  <% if (j.fase !== 'grupo' && j.palpite_classificado_id) { %>
                    <div style="font-size:0.65rem;color:var(--cinza-escuro)">
                      <%= j.palpite_classificado_id === j.selecao_casa_id ? j.casa_sigla : j.visitante_sigla %>
                    </div>
                  <% } %>
                <% } else { %>
                  <span class="texto-aux">—</span>
                <% } %>
              </td>
              <td class="text-center">
                <% if (j.pontos_obtidos !== null) { %>
                  <span class="pontos-badge <%= j.pontos_obtidos === 0 ? 'zero' : '' %>"><%= j.pontos_obtidos %></span>
                <% } else { %>
                  <span class="texto-aux">—</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</details>

<!-- Racha -->
<div class="card">
  <h3 style="margin-top:0">⚔️ Comparar com outro participante</h3>
  <form method="GET" action="/resumo" style="display:flex;gap:8px;align-items:end;flex-wrap:wrap">
    <div class="form-group" style="margin:0;flex:1;min-width:200px">
      <select name="com" class="form-control">
        <option value="">— Selecione —</option>
        <% participantes.forEach(function(p) { %>
          <option value="<%= p.id %>" <%= String(p.id) === rachaId ? 'selected' : '' %>><%= p.nome %></option>
        <% }); %>
      </select>
    </div>
    <button type="submit" class="btn btn-primary">Comparar</button>
  </form>

  <% if (racha) { %>
    <%
      const diffTotal = racha.pontosEu - racha.pontosEle;
      const fmtDiff = (n) => (n > 0 ? '+' + n : String(n));
      const corDiff = (n) => n > 0 ? 'var(--verde)' : (n < 0 ? 'var(--erro)' : 'var(--cinza-escuro)');
    %>
    <div style="margin-top:16px;display:flex;gap:16px;flex-wrap:wrap">
      <div style="flex:1;min-width:160px;text-align:center;padding:16px;background:var(--verde);color:white;border-radius:8px">
        <div style="font-size:0.8rem;opacity:0.9">Você</div>
        <div style="font-size:1.8rem;font-weight:800"><%= racha.pontosEu %></div>
        <div style="font-size:0.7rem;opacity:0.85">
          palpites: <%= racha.palpitesEuTotal %><% if (racha.bonusEu > 0) { %> · bônus/extras: +<%= racha.bonusEu %><% } %>
        </div>
      </div>
      <div style="flex:1;min-width:160px;text-align:center;padding:16px;background:var(--cinza);border-radius:8px">
        <div style="display:flex;align-items:center;justify-content:center;gap:6px;font-size:0.8rem;color:var(--cinza-escuro)">
          <img src="/foto/<%= racha.usuario.id %>" alt="" style="width:24px;height:24px;border-radius:50%;object-fit:cover" onerror="this.outerHTML='👤'">
          <%= racha.usuario.nome %>
        </div>
        <div style="font-size:1.8rem;font-weight:800"><%= racha.pontosEle %></div>
        <div style="font-size:0.7rem;color:var(--cinza-escuro)">
          palpites: <%= racha.palpitesEleTotal %><% if (racha.bonusEle > 0) { %> · bônus/extras: +<%= racha.bonusEle %><% } %>
        </div>
      </div>
    </div>

    <div style="margin-top:8px;text-align:center;font-size:0.95rem;font-weight:700;color:<%= corDiff(diffTotal) %>">
      Diferença total: <%= fmtDiff(diffTotal) %> pts
    </div>

    <div style="margin-top:12px;text-align:center">
      <span style="padding:4px 12px;background:var(--verde);color:white;border-radius:4px;margin:0 4px"><%= racha.vitorias %> vitórias</span>
      <span style="padding:4px 12px;background:var(--cinza);border-radius:4px;margin:0 4px"><%= racha.empates %> empates</span>
      <span style="padding:4px 12px;background:var(--erro);color:white;border-radius:4px;margin:0 4px"><%= racha.derrotas %> derrotas</span>
    </div>

    <% if (racha.pontosPorRodada && racha.pontosPorRodada.length > 0) { %>
      <h4 style="margin:18px 0 6px;font-size:0.9rem">📊 Pontos por rodada / fase</h4>
      <div style="overflow-x:auto">
        <table class="ranking-tabela" style="font-size:0.85rem">
          <thead>
            <tr>
              <th>Rodada / Fase</th>
              <th class="text-center">Você</th>
              <th class="text-center"><%= racha.usuario.nome %></th>
              <th class="text-center">Diferença</th>
            </tr>
          </thead>
          <tbody>
            <% racha.pontosPorRodada.forEach(function(linha) { %>
              <tr>
                <td><strong><%= linha.label %></strong></td>
                <td class="text-center"><%= linha.eu %></td>
                <td class="text-center"><%= linha.ele %></td>
                <td class="text-center" style="font-weight:700;color:<%= corDiff(linha.diff) %>"><%= fmtDiff(linha.diff) %></td>
              </tr>
            <% }); %>
          </tbody>
          <tfoot>
            <tr style="background:var(--cinza-claro);font-weight:700">
              <td>Subtotal palpites</td>
              <td class="text-center"><%= racha.palpitesEuTotal %></td>
              <td class="text-center"><%= racha.palpitesEleTotal %></td>
              <td class="text-center" style="color:<%= corDiff(racha.palpitesEuTotal - racha.palpitesEleTotal) %>"><%= fmtDiff(racha.palpitesEuTotal - racha.palpitesEleTotal) %></td>
            </tr>
            <% if (racha.bonusEu > 0 || racha.bonusEle > 0) { %>
              <tr>
                <td>Bônus + extras</td>
                <td class="text-center" style="color:var(--cinza-escuro)"><%= racha.bonusEu > 0 ? '+' + racha.bonusEu : '—' %></td>
                <td class="text-center" style="color:var(--cinza-escuro)"><%= racha.bonusEle > 0 ? '+' + racha.bonusEle : '—' %></td>
                <td class="text-center" style="color:<%= corDiff(racha.bonusEu - racha.bonusEle) %>"><%= fmtDiff(racha.bonusEu - racha.bonusEle) %></td>
              </tr>
              <tr style="background:var(--cinza-claro);font-weight:700">
                <td>Total geral</td>
                <td class="text-center"><%= racha.pontosEu %></td>
                <td class="text-center"><%= racha.pontosEle %></td>
                <td class="text-center" style="color:<%= corDiff(diffTotal) %>"><%= fmtDiff(diffTotal) %></td>
              </tr>
            <% } %>
          </tfoot>
        </table>
      </div>
    <% } %>

    <% if (racha.top5Gaps && racha.top5Gaps.length > 0) { %>
      <h4 style="margin:18px 0 6px;font-size:0.9rem">🔥 Top 5 maiores diferenças jogo a jogo</h4>
      <p class="texto-aux" style="font-size:0.75rem;margin:0 0 6px">Onde o gap entre você e <%= racha.usuario.nome %> foi maior (em pontos absolutos). <strong style="color:var(--verde)">Verde</strong> = você ganhou mais; <strong style="color:var(--erro)">vermelho</strong> = você perdeu mais.</p>
      <div style="display:flex;flex-direction:column;gap:4px">
        <% racha.top5Gaps.forEach(function(g) {
             const siglaFase = { grupo: 'G', r32: '16av', r16: '8av', qf: 'QF', sf: 'SF', terceiro: '3º', final: 'F' };
             const fLabel = (siglaFase[g.fase] || g.fase) + (g.rodada && g.fase === 'grupo' ? '·' + g.rodada : '');
        %>
          <div style="display:flex;align-items:center;gap:8px;padding:6px 10px;background:var(--cinza-claro);border-radius:6px;font-size:0.85rem;flex-wrap:wrap">
            <span style="background:var(--cinza);color:#fff;padding:2px 6px;border-radius:8px;font-size:0.7rem;font-weight:600"><%= fLabel %></span>
            <strong><%= g.casa_sigla || '?' %></strong>
            <span style="background:var(--azul);color:#fff;padding:1px 6px;border-radius:4px;font-weight:700;font-size:0.8rem"><%= g.placar %></span>
            <strong><%= g.visitante_sigla || '?' %></strong>
            <span style="margin-left:auto;display:flex;gap:8px;align-items:center;font-size:0.8rem">
              <span>Você: <strong><%= g.ptsEu %></strong></span>
              <span style="color:var(--cinza-escuro)">·</span>
              <span>Ele: <strong><%= g.ptsEle %></strong></span>
              <span style="font-weight:800;color:<%= corDiff(g.diff) %>;min-width:36px;text-align:right"><%= fmtDiff(g.diff) %></span>
            </span>
          </div>
        <% }); %>
      </div>
    <% } %>
  <% } %>
</div>

<%- include('partials/footer') %>
