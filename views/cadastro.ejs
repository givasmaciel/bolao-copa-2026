<%- include('partials/header', { active: 'cadastro' }) %>

<%- include('partials/flash') %>

<div class="auth-container">
  <div class="card">
    <h1>Criar conta</h1>
    <p class="subtitulo">Entre para o bolão da Copa 2026!</p>

    <form method="POST" action="/cadastro">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label for="nome">Nome</label>
        <input type="text" id="nome" name="nome" class="form-control" required autofocus value="<%= dados.nome || '' %>" placeholder="Como quer ser chamado">
      </div>
      <div class="form-group">
        <label for="email">E-mail</label>
        <input type="email" id="email" name="email" class="form-control" required value="<%= dados.email || '' %>" placeholder="seu@email.com">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="senha">Senha</label>
          <input type="password" id="senha" name="senha" class="form-control" required minlength="4" placeholder="Mínimo 4 caracteres">
        </div>
        <div class="form-group">
          <label for="confirmar">Confirmar senha</label>
          <input type="password" id="confirmar" name="confirmar" class="form-control" required minlength="4" placeholder="Digite de novo">
        </div>
      </div>
      <button type="submit" class="btn btn-primary btn-block btn-lg">Criar conta e entrar</button>
    </form>

    <p class="link-aux">
      Já tem conta? <a href="/login">Entrar</a>
    </p>
  </div>
</div>

<%- include('partials/footer') %>
