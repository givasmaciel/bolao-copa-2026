<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#009739">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Bolão 2026">
  <meta name="description" content="Faça seus palpites da Copa do Mundo FIFA 2026 e concorra com seus amigos">
  <title><%= typeof title !== 'undefined' ? title + ' - Bolão da Copa 2026' : 'Bolão da Copa 2026' %></title>
  <script>
    // Aplica tema ANTES do CSS carregar para evitar flash de cor errada
    (function() {
      try {
        var saved = localStorage.getItem('bolao-theme');
        var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = saved || (prefersDark ? 'dark' : 'light');
        if (theme === 'dark') document.documentElement.classList.add('dark');
        else if (saved === 'light') document.documentElement.classList.add('light');
      } catch (e) { /* localStorage bloqueado em modo privado */ }
    })();
  </script>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/icon-192.svg">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E⚽%3C/text%3E%3C/svg%3E">
</head>
<body>
  <header>
    <div class="header-container">
      <a href="/" class="logo">
        <span class="logo-icon">⚽</span>
        <span class="logo-text">
          Bolão da Copa
          <small>FIFA 2026 • EUA/MEX/CAN</small>
        </span>
      </a>
      <nav>
        <ul>
          <% if (usuario) { %>
            <li><a href="/dashboard" class="<%= typeof active !== 'undefined' && active === 'dashboard' ? 'active' : '' %>">Painel</a></li>
            <li><a href="/palpites" class="<%= typeof active !== 'undefined' && active === 'palpites' ? 'active' : '' %>">Meus palpites</a></li>
            <li><a href="/jogos" class="<%= typeof active !== 'undefined' && active === 'jogos' ? 'active' : '' %>">Jogos</a></li>
            <li><a href="/palpites-extras" class="<%= typeof active !== 'undefined' && active === 'extras' ? 'active' : '' %>">Palpites Extras</a></li>
            <li><a href="/resumo" class="<%= typeof active !== 'undefined' && active === 'resumo' ? 'active' : '' %>">Resumo</a></li>
            <li><a href="/ranking" class="<%= typeof active !== 'undefined' && active === 'ranking' ? 'active' : '' %>">Ranking</a></li>
            <li><a href="/classificacao" class="<%= typeof active !== 'undefined' && active === 'classificacao' ? 'active' : '' %>">Grupos</a></li>
            <li><a href="/config" class="<%= typeof active !== 'undefined' && active === 'config' ? 'active' : '' %>">Conta</a></li>
            <% if (usuario.is_admin) { %>
              <li><a href="/admin" class="<%= typeof active !== 'undefined' && active === 'admin' ? 'active' : '' %>">⚙ Admin</a></li>
            <% } %>
            <li>
              <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Alternar tema" title="Alternar tema claro/escuro">
                <span class="icon-moon" aria-hidden="true">🌙</span>
                <span class="icon-sun" aria-hidden="true">☀️</span>
              </button>
            </li>
            <li class="user-pill">
              <img src="/foto/<%= usuario.id %>" alt="" style="width:24px;height:24px;border-radius:50%;object-fit:cover" onerror="this.outerHTML='<span style=font-size:1.1rem>👤</span>'">
              <%= usuario.nome %>
              <form method="POST" action="/logout" style="display:inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit">Sair</button>
              </form>
            </li>
          <% } else { %>
            <li><a href="/login">Entrar</a></li>
            <li><a href="/cadastro">Criar conta</a></li>
          <% } %>
        </ul>
      </nav>
    </div>
  </header>
  <% if (usuario) { %>
  <div id="header-countdown" style="background:var(--amarelo);padding:4px 0;text-align:center;font-size:0.78rem;font-weight:600;color:var(--texto);display:none">
    <span id="hc-text">Carregando...</span>
  </div>
  <script>
  (function() {
    var el = document.getElementById('header-countdown');
    var txt = document.getElementById('hc-text');
    fetch('/api/proximo-jogo').then(function(r) { return r.json(); }).then(function(d) {
      if (!d.ok) { el.style.display = 'none'; return; }
      el.style.display = 'block';
      function tick() {
        var agora = new Date();
        var fecha = new Date(d.fechaEm);
        var diff = fecha.getTime() - agora.getTime();
        if (diff <= 0) {
          txt.innerHTML = '🔒 <strong>' + d.casa + ' × ' + d.visitante + '</strong> — Fechado para palpites!';
        } else {
          var h = Math.floor(diff / 3600000);
          var m = Math.floor((diff % 3600000) / 60000);
          var s = Math.floor((diff % 60000) / 1000);
          txt.innerHTML = '⏱ Próximo: <strong>' + d.casa + ' × ' + d.visitante + '</strong> — Fecha em ' + h + 'h ' + m + 'min ' + s + 's';
        }
      }
      tick();
      setInterval(tick, 1000);
    }).catch(function() { el.style.display = 'none'; });
  })();
  </script>
  <% } %>
  <main>
