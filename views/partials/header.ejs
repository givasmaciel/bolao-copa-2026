<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' - Bolão da Copa 2026' : 'Bolão da Copa 2026' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E⚽%3C/text%3E%3C/svg%3E">
</head>
<body>
  <header>
    <div class="header-container">
      <a href="/" class="logo">
        <span class="logo-icon">⚽</span>
        <span class="logo-text">
          Bolão da Copa
          <small>FIFA 2026 • EUA/MEX/CAN</small>
        </span>
      </a>
      <nav>
        <ul>
          <li><a href="/jogos" class="<%= typeof active !== 'undefined' && active === 'jogos' ? 'active' : '' %>">Jogos</a></li>
          <% if (usuario) { %>
            <li><a href="/dashboard" class="<%= typeof active !== 'undefined' && active === 'dashboard' ? 'active' : '' %>">Painel</a></li>
            <li><a href="/palpites" class="<%= typeof active !== 'undefined' && active === 'palpites' ? 'active' : '' %>">Meus palpites</a></li>
            <li><a href="/palpites-extras" class="<%= typeof active !== 'undefined' && active === 'extras' ? 'active' : '' %>">Extras</a></li>
            <li><a href="/resumo" class="<%= typeof active !== 'undefined' && active === 'resumo' ? 'active' : '' %>">Resumo</a></li>
            <li><a href="/ranking" class="<%= typeof active !== 'undefined' && active === 'ranking' ? 'active' : '' %>">Ranking</a></li>
            <li><a href="/classificacao" class="<%= typeof active !== 'undefined' && active === 'classificacao' ? 'active' : '' %>">Grupos</a></li>
            <li><a href="/config" class="<%= typeof active !== 'undefined' && active === 'config' ? 'active' : '' %>">Conta</a></li>
            <% if (usuario.is_admin) { %>
              <li><a href="/admin" class="<%= typeof active !== 'undefined' && active === 'admin' ? 'active' : '' %>">⚙ Admin</a></li>
            <% } %>
            <li class="user-pill">
              👤 <%= usuario.nome %>
              <form method="POST" action="/logout" style="display:inline">
                <button type="submit">Sair</button>
              </form>
            </li>
          <% } else { %>
            <li><a href="/login">Entrar</a></li>
            <li><a href="/cadastro">Criar conta</a></li>
          <% } %>
        </ul>
      </nav>
    </div>
  </header>
  <main>
