<%- include('partials/header', { active: 'ranking' }) %>

<%- include('partials/flash') %>

<div style="display:flex;align-items:center;gap:16px;margin-bottom:8px">
  <div style="flex-shrink:0">
    <img src="/foto/<%= usuario.id %>" alt="" style="width:64px;height:64px;border-radius:50%;object-fit:cover;border:3px solid var(--verde)" onerror="this.outerHTML='<div style=width:64px;height:64px;border-radius:50%;background:var(--cinza);display:flex;align-items:center;justify-content:center;font-size:2rem;border:3px solid var(--cinza-escuro)>👤</div>'">
  </div>
  <div>
    <h1 style="margin:0"><%= usuario.nome %></h1>
    <p class="subtitulo" style="margin:0">Membro desde <%= new Date(usuario.criado_em).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %></p>
  </div>
</div>

<% if (stats) { %>
  <%
    var totalPts = (stats.pontos || 0) + extrasPontos + bonusPontos;
    var mediaPalpite = (stats.total || 0) > 0 ? ((stats.pontos || 0) / stats.total).toFixed(1) : '—';
  %>
  <div class="card mb-2" style="padding:8px 12px">
    <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:4px;text-align:center">
      <div><div style="font-size:1.2rem;font-weight:800"><%= stats.total || 0 %></div><div style="font-size:0.7rem;color:var(--cinza-escuro)">Palpites</div></div>
      <div><div style="font-size:1.2rem;font-weight:800"><%= stats.acertos || 0 %></div><div style="font-size:0.7rem;color:var(--cinza-escuro)">Pontuados</div></div>
      <div><div style="font-size:1.2rem;font-weight:800"><%= totalPts %></div><div style="font-size:0.7rem;color:var(--cinza-escuro)">Pontos<% if (extrasPontos > 0) { %> <span style="color:var(--cinza-escuro)">(+<%= extrasPontos %> extras)</span><% } %><% if (bonusPontos > 0) { %> <span style="color:var(--verde)">(+<%= bonusPontos %> bônus)</span><% } %></div></div>
      <div><div style="font-size:1.2rem;font-weight:800"><%= aproveitamento %>%</div><div style="font-size:0.7rem;color:var(--cinza-escuro)">Aproveit.</div></div>
      <div><div style="font-size:1.2rem;font-weight:800"><%= mediaPalpite %></div><div style="font-size:0.7rem;color:var(--cinza-escuro)">Média/palpite</div></div>
      <div><div style="font-size:1rem;font-weight:700;color:var(--cinza-escuro)"><%= totalDisputado %></div><div style="font-size:0.7rem;color:var(--cinza-escuro)">Pts disp.</div></div>
    </div>
  </div>
<% } %>

<% if (!palpites || palpites.length === 0) { %>
  <div class="card text-center">
    <p>😕 Este participante ainda não fez nenhum palpite.</p>
    <a href="/ranking" class="btn btn-primary mt-2">Voltar ao ranking</a>
  </div>
<% } else { %>
  <h2>Palpites por rodada</h2>
  <p class="texto-aux">🔒 Palpites de jogos ainda abertos são exibidos apenas após o fechamento.</p>
  <% let rodadaAtual = null; %>
  <% palpites.forEach(function(p) { %>
    <%
      const dataJogo = new Date(p.data);
      const palpiteLimite = p.palpite_limite ? new Date(p.palpite_limite) : null;
      const margem = palpiteLimite || new Date(dataJogo.getTime() - PALPITE_MARGEM_MS);
      const fechado = agora >= margem || p.finalizado === 1;
    %>
    <% if (p.rodada !== rodadaAtual) { %>
      <% if (rodadaAtual !== null) { %><% /* fecha a anterior */ %><% } %>
      <h3 class="jogo-rodada-titulo">Rodada <%= p.rodada %></h3>
      <% rodadaAtual = p.rodada; %>
    <% } %>
    <div class="jogo-card <%= p.finalizado === 1 ? 'finalizado' : '' %>">
      <div class="jogo-time">
        <span><%= p.casa_pt %></span>
      </div>
      <div class="jogo-info">
        <% if (p.finalizado === 1) { %>
          <div class="jogo-placar-display"><%= p.gols_casa %> × <%= p.gols_visitante %></div>
          <% if (p.fase !== 'grupo') { %>
            <% if (p.gols_casa_pror !== null && p.gols_casa_pror !== undefined) { %>
              <div style="font-size:0.7rem;color:var(--cinza-escuro);margin-top:2px">⏱ Prorrogação: <%= p.gols_casa_pror %> × <%= p.gols_visitante_pror %></div>
            <% } %>
            <% if (p.placar_penaltis_casa !== null && p.placar_penaltis_casa !== undefined) { %>
              <div style="font-size:0.7rem;color:var(--cinza-escuro);margin-top:2px">🎯 Pênaltis: <%= p.placar_penaltis_casa %> × <%= p.placar_penaltis_visitante %></div>
            <% } %>
            <% if (p.classificado_pt) { %>
              <div style="font-size:0.7rem;color:var(--verde);font-weight:600;margin-top:2px">✅ <%= p.classificado_pt %> classificou</div>
            <% } %>
          <% } %>
        <% } else { %>
          <div class="jogo-placar-display" style="color:#aaa">×</div>
        <% } %>
        <div style="margin-top:6px">
          <% if (fechado) { %>
            <strong>Palpite:</strong>
            <%= p.palpite_gols_casa %> × <%= p.palpite_gols_visitante %>
            <% if (p.fase !== 'grupo' && p.palpite_classificado_id) { %>
              <span style="font-size:0.72rem;color:var(--cinza-escuro);margin-left:4px">
                / <%= p.palpite_classificado_id === p.selecao_casa_id ? p.casa_sigla : p.visitante_sigla %> classifica
              </span>
            <% } %>
          <% } else { %>
            <span style="color:var(--cinza-escuro);font-size:0.85rem">🔒 Palpite bloqueado até o fechamento do jogo</span>
          <% } %>
        </div>
        <% if (p.finalizado === 1) { %>
          <div class="pontos-badge <%= (p.pontos_obtidos || 0) === 0 ? 'zero' : '' %>">
            <%= p.pontos_obtidos || 0 %> pts
          </div>
        <% } %>
      </div>
      <div class="jogo-time visitante">
        <span><%= p.visitante_pt %></span>
      </div>
    </div>
  <% }); %>

  <% if (typeof extras !== 'undefined' && extrasLiberado) { %>
    <div class="card mt-2">
      <h3 style="margin-top:0">🏆 Palpites extras</h3>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:8px">
        <% CATEGORIAS.forEach(function(cat) { %>
          <% const picks = extras.filter(function(e) { return e.categoria === cat.id; }); %>
          <% if (picks.length > 0) { %>
            <div style="background:var(--cinza-claro);padding:8px 12px;border-radius:8px">
              <strong style="font-size:0.8rem;display:block;margin-bottom:4px"><%= cat.nome %></strong>
              <% picks.forEach(function(e) { %>
                <span style="display:inline-block;background:var(--azul);color:#fff;padding:2px 8px;border-radius:10px;font-size:0.75rem;margin:1px"><%= e.nome_pt %></span>
              <% }); %>
            </div>
          <% } %>
        <% }); %>
      </div>
    </div>
  <% } else if (typeof extras !== 'undefined' && extras.length > 0) { %>
    <div class="card text-center">
      <p class="texto-aux">🔒 Palpites extras bloqueados até <%= extrasPrazo.toLocaleString('pt-BR', { dateStyle:'long', timeStyle:'short', timeZone:'America/Sao_Paulo' }) %></p>
    </div>
  <% } %>

  <div class="text-center mt-3">
    <a href="/ranking" class="btn btn-secondary">← Voltar ao ranking</a>
  </div>
<% } %>

<%- include('partials/footer') %>
