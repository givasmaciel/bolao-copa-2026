<%- include('partials/header', { active: 'extras' }) %>

<%- include('partials/flash') %>

<h1>🏆 Palpites Extras</h1>
<p class="subtitulo">Aposte nas seleções para cada fase do torneio. Cada acerto vale pontos extras no ranking!</p>

<div class="card mb-2" style="border-left:4px solid var(--amarelo)">
  <p><strong>📅 Data limite:</strong> <%= dataLimite.toLocaleString('pt-BR', { dateStyle: 'long', timeStyle: 'short', timeZone: 'America/Sao_Paulo' }) %></p>
  <p class="texto-aux mt-1">Após essa data, os palpites extras serão travados.</p>
</div>

<% 
  const temExtras = Object.values(palpites).some(function(arr) { return arr && arr.length > 0; });
%>
<% if (temExtras) { %>
<div class="card" style="border-left:4px solid var(--verde); margin-bottom:20px">
  <h3 style="margin:0 0 12px">✅ Seus palpites extras salvos</h3>
  <div class="grid grid-2">
    <% categorias.forEach(function(cat) { %>
      <% if (palpites[cat.id] && palpites[cat.id].length > 0) { %>
        <div style="background:var(--cinza-claro);padding:10px 14px;border-radius:8px;border-left:3px solid var(--verde)">
          <strong style="font-size:0.85rem;display:block;margin-bottom:6px"><%= cat.nome %> (<%= cat.pts %> pts)</strong>
          <div style="display:flex;flex-wrap:wrap;gap:4px">
            <% 
              const selecoesCat = selecoes.filter(function(s) { return palpites[cat.id].includes(s.id); });
              selecoesCat.forEach(function(s) { 
            %>
              <span style="display:inline-block;background:var(--verde);color:#fff;padding:3px 10px;border-radius:12px;font-size:0.8rem;font-weight:500">
                <%= s.nome_pt %>
              </span>
            <% }); %>
          </div>
        </div>
      <% } %>
    <% }); %>
  </div>
</div>
<% } %>

<% if (prazoPassou) { %>
  <div class="flash aviso">⚠ O prazo para palpites extras já encerrou.</div>
<% } %>

<div class="grid grid-2">
  <% categorias.forEach(function(cat) { %>
    <form method="POST" action="/palpites-extras/<%= cat.id %>" class="card">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <div class="flex-between">
          <h3 style="margin:0"><%= cat.nome %></h3>
          <div class="text-right">
            <span class="pontos-badge"><%= cat.pts %> pts</span>
            <% if (cat.max > 1) { %>
              <div class="texto-aux mt-1">
                <span id="count-<%= cat.id %>"><%= palpites[cat.id] ? palpites[cat.id].length : 0 %></span> / <%= cat.max %> selecionadas
              </div>
            <% } %>
          </div>
        </div>
        <div class="form-group mt-2" style="margin-bottom:0">
          <% if (multiCats.has(cat.id)) { %>
            <div style="max-height:320px; overflow-y:auto; border:1px solid var(--cinza); border-radius:8px; padding:8px" class="selecoes-lista" data-categoria="<%= cat.id %>">
              <% selecoes.forEach(function(s) { %>
                <label style="display:flex; align-items:center; gap:8px; padding:4px 6px; border-radius:4px; cursor:pointer; <%= palpites[cat.id] && palpites[cat.id].includes(s.id) ? 'background:var(--cinza-claro);font-weight:600' : '' %>">
                  <input type="checkbox" name="selecoes" value="<%= s.id %>"
                    <%= palpites[cat.id] && palpites[cat.id].includes(s.id) ? 'checked' : '' %>
                    <%= prazoPassou ? 'disabled' : '' %>>
                  <%= s.nome_pt %>
                </label>
              <% }); %>
            </div>
          <% } else { %>
            <select name="selecao" class="form-control" <%= prazoPassou ? 'disabled' : '' %>>
              <option value="">— Selecione —</option>
              <% selecoes.forEach(function(s) { %>
                <option value="<%= s.id %>" <%= palpites[cat.id] && palpites[cat.id].includes(s.id) ? 'selected' : '' %>>
                  <%= s.nome_pt %>
                </option>
              <% }); %>
            </select>
          <% } %>
        </div>
      </div>
      <% if (!prazoPassou) { %>
        <div class="text-center mt-3">
          <button type="submit" class="btn btn-primary">💾 Salvar <%= cat.nome %></button>
        </div>
      <% } %>
    </form>
  <% }); %>
</div>

<script>
document.querySelectorAll('.selecoes-lista').forEach(function(container) {
  var catId = container.dataset.categoria;
  var checkboxes = container.querySelectorAll('input[type="checkbox"]');
  var counter = document.getElementById('count-' + catId);
  var max = parseInt(container.closest('.card').querySelector('.texto-aux')?.textContent?.match(/(\d+)\s*\/\s*(\d+)/)?.[2]) || Infinity;
  checkboxes.forEach(function(cb) {
    cb.addEventListener('change', function() {
      var checked = container.querySelectorAll('input[type="checkbox"]:checked').length;
      if (this.checked && checked > max) {
        this.checked = false;
        checked--;
      }
      counter.textContent = checked;
    });
  });
});
</script>

<%- include('partials/footer') %>
