<%- include('partials/header', { active: 'ranking' }) %>

<%- include('partials/flash') %>

<h1>🏆 Ranking do Bolão</h1>
<p class="subtitulo">Veja quem está mandando bem nos palpites da Copa 2026!</p>

<% if (totais) { %>
  <div class="grid grid-5 mb-2">
    <div class="stat-card">
      <div class="stat-valor"><%= totais.total_usuarios %></div>
      <div class="stat-label">Participantes</div>
    </div>
    <div class="stat-card">
      <div class="stat-valor"><%= totais.jogos_finalizados %>/<%= totais.total_jogos %></div>
      <div class="stat-label">Jogos finalizados</div>
    </div>
    <div class="stat-card">
      <div class="stat-valor"><%= totais.total_palpites %></div>
      <div class="stat-label">Palpites no total</div>
    </div>
    <div class="stat-card">
      <div class="stat-valor"><%= ranking.length > 0 ? ranking[0].total_pontos : 0 %></div>
      <div class="stat-label">Pontos do líder</div>
    </div>
    <div class="stat-card">
      <div class="stat-valor"><%= totalDisputado %></div>
      <div class="stat-label">Pontos disponíveis</div>
    </div>
  </div>
<% } %>

<% if (ranking.length === 0) { %>
  <div class="card text-center">
    <p>😕 Ninguém palpitou ainda. <a href="/cadastro">Seja o primeiro!</a></p>
  </div>
<% } else { %>
  <p class="texto-aux" style="font-size:0.8rem;margin-bottom:8px">
    ⓘ Para evitar vantagem ou desvantagem excessiva, os participantes que ingressarem após o início da competição iniciarão com uma pontuação igual à do último colocado da classificação na rodada de ingresso, reduzida em 1 (um) ponto. Após o encerramento dos palpites extras, não serão aceitas novas inscrições.
  </p>
  <table class="ranking-tabela">
    <thead>
      <tr>
        <th class="pos">#</th>
        <th>Participante</th>
        <th class="text-center">Palpites</th>
        <th class="text-center">Acertos</th>
        <th class="text-center">Melhor</th>
        <th class="text-center">Extras</th>
        <th class="text-center">Bônus <span style="font-size:0.7rem;cursor:help;color:var(--cinza-escuro)" title="Motivo do bônus visível ao passar o mouse sobre o valor">ⓘ</span></th>
        <th class="text-center">Aproveit.</th>
        <th class="text-center">Pontos</th>
      </tr>
    </thead>
    <tbody>
      <% ranking.forEach(function(u) { %>
        <tr class="<%= typeof usuario !== 'undefined' && usuario && usuario.id === u.id ? 'voce' : '' %>">
          <td class="pos <%= u.posicao === 1 ? 'pos-1' : (u.posicao === 2 ? 'pos-2' : (u.posicao === 3 ? 'pos-3' : '')) %>">
            <% if (u.posicao === 1) { %>🥇<% } else if (u.posicao === 2) { %>🥈<% } else if (u.posicao === 3) { %>🥉<% } else { %><%= u.posicao %>º<% } %>
          </td>
          <td>
            <div style="display:flex;align-items:center;gap:8px">
              <img src="/foto/<%= u.id %>" alt="" class="avatar" onerror="this.outerHTML='<span class=avatar-placeholder>👤</span>'">
              <a href="/ranking/usuario/<%= u.id %>"><%= u.nome %></a>
              <% if (typeof usuario !== 'undefined' && usuario && usuario.id === u.id) { %>
                <span class="texto-aux" style="color:var(--verde); font-weight:600">(você)</span>
              <% } %>
            </div>
          </td>
          <td class="text-center"><%= u.total_palpites %></td>
          <td class="text-center"><%= u.palpites_com_pontos %></td>
          <td class="text-center"><%= u.maior_palpite %> pts</td>
          <td class="text-center"><%= u.extras_pontos > 0 ? '+' + u.extras_pontos : '—' %></td>
          <td class="text-center" style="cursor:help;<% if (u.bonus_pontos > 0) { %>text-decoration:underline dotted;text-underline-offset:3px<% } %>"
            <% if (u.bonus_pontos > 0 && bonusMap && bonusMap[u.id]) { %>
              title="<%= bonusMap[u.id].map(function(b) { return (b.motivo || 'sem motivo') + ': +' + b.pontos + ' pts'; }).join('; ') %>"
            <% } %>
          ><%= u.bonus_pontos > 0 ? '+' + u.bonus_pontos : '—' %></td>
          <td class="text-center"><%= u.aproveitamento %>%</td>
          <td class="text-center pontos"><%= u.total_pontos %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } %>

<div class="card mt-3">
  <h2>📊 Ranking por rodada</h2>
  <p class="texto-aux">Pontos acumulados em cada rodada. <strong>R1</strong> a <strong>R3</strong> = grupos, <strong>32av</strong> a <strong>Final</strong> = mata-mata.</p>
  <div style="overflow-x:auto">
    <table class="ranking-tabela">
      <thead>
        <tr>
          <th>#</th>
          <th>Participante</th>
          <% rodadas.forEach(function(r) { %>
            <th class="text-center"><%= labels[r] %></th>
          <% }); %>
          <th class="text-center">Extra</th>
          <th class="text-center">Total</th>
        </tr>
      </thead>
      <tbody>
        <% ranking.forEach(function(u, idx) { %>
          <tr class="<%= typeof usuario !== 'undefined' && usuario && usuario.id === u.id ? 'voce' : '' %>">
            <td class="text-center"><%= idx + 1 %></td>
            <td><%= u.nome %></td>
            <% rodadas.forEach(function(r) { %>
              <td class="text-center"><%= (rodadaMap[u.id] && rodadaMap[u.id][r]) || '—' %></td>
            <% }); %>
            <td class="text-center" style="color:var(--cinza-escuro)"><%= (u.extras_pontos || 0) + (u.bonus_pontos || 0) > 0 ? '+' + ((u.extras_pontos || 0) + (u.bonus_pontos || 0)) : '—' %></td>
            <td class="text-center pontos"><%= u.total_pontos %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<% if (extrasResultados && extrasResultados.length > 0) { %>
<div class="card mt-3">
  <h2>🏆 Resultados dos Palpites Extras</h2>
  <p class="texto-aux">Seleções vencedoras definidas pelo administrador e participantes que acertaram cada categoria.</p>

  <% CATEGORIAS.forEach(function(cat) {
    const items = extrasPorCategoria[cat.id];
    if (!items || items.length === 0) return;
  %>
    <div style="margin-top:16px">
      <h3 style="margin:0 0 8px;display:flex;align-items:center;gap:8px">
        <%= cat.nome %>
        <span class="pontos-badge"><%= cat.pts %> pts</span>
      </h3>
      <% items.forEach(function(item) { %>
        <div style="background:var(--cinza-claro);border-radius:8px;padding:8px 12px;margin-bottom:6px">
          <div style="display:flex;align-items:center;gap:8px;font-weight:600;font-size:0.9rem">
            <span style="background:var(--verde);color:#fff;padding:2px 8px;border-radius:10px;font-size:0.75rem"><%= item.sigla %></span>
            <%= item.nome_pt %>
          </div>
          <% if (item.acertaram.length > 0) { %>
            <div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:6px">
              <% item.acertaram.forEach(function(a) { %>
                <a href="/ranking/usuario/<%= a.usuario_id %>" style="display:inline-block;background:var(--azul);color:#fff;padding:2px 10px;border-radius:10px;font-size:0.8rem;text-decoration:none">
                  <%= a.nome %>
                </a>
              <% }); %>
            </div>
          <% } else { %>
            <p class="texto-aux" style="font-size:0.8rem;margin:4px 0 0">Ninguém acertou esta seleção.</p>
          <% } %>
        </div>
      <% }); %>
    </div>
  <% }); %>
</div>
<% } %>

<%- include('partials/footer') %>
