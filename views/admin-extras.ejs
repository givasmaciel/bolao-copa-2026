<%- include('partials/header', { active: 'admin' }) %>

<%- include('partials/flash') %>

<h1>🏆 Resultados Extras</h1>
<p class="subtitulo">Marque as seleções vencedoras de cada categoria. Os pontos extras serão somados ao ranking automaticamente.</p>

<div class="card mb-2">
  <h3>📅 Prazo dos palpites extras</h3>
  <form method="POST" action="/admin/extras/config" class="flex gap-1" style="align-items:end; flex-wrap:wrap">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group" style="margin:0">
      <label>Data e hora limite (formato: <code>YYYY-MM-DDTHH:MM</code>)</label>
      <input type="datetime-local" name="data_limite" class="form-control" style="width:220px"
        value="<%= dataLimite.toLocaleString('sv-SE', { timeZone: 'America/Sao_Paulo', dateStyle: 'short', timeStyle: 'short' }).replace(' ', 'T').slice(0, 16) %>" required>
    </div>
    <button type="submit" class="btn btn-sm btn-primary">💾 Salvar prazo</button>
  </form>
  <p class="texto-aux mt-1">
    Atual: <strong><%= dataLimite.toLocaleString('pt-BR', { dateStyle: 'long', timeStyle: 'short', timeZone: 'America/Sao_Paulo' }) %></strong>.
    Os participantes <strong>não poderão</strong> alterar os palpites extras após essa data.
  </p>
</div>

<%
  // Ordem: final → início (r32 por último)
  const ordemAdmin = ['campeao', 'vice', 'terceiro', 'finalista', 'semi', 'quartas', 'oitavas', 'r32'];
  const catsOrdenadas = ordemAdmin.map(function(id) { return categorias.find(function(c) { return c.id === id; }); }).filter(function(c) { return c; });
%>

<div class="grid grid-2">
  <% catsOrdenadas.forEach(function(cat) { %>
    <form method="POST" action="/admin/extras" class="card">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="_categoria" value="<%= cat.id %>">
      <div>
        <div class="flex-between">
          <h3 style="margin:0"><%= cat.nome %></h3>
          <span class="pontos-badge"><%= cat.pts %> pts</span>
        </div>
        <div class="form-group mt-2" style="margin-bottom:0">
          <% if (multiCats.has(cat.id)) { %>
            <div class="flex-between" style="margin-bottom:4px">
              <span id="counter-<%= cat.id %>" style="font-size:0.85rem;font-weight:600;color:var(--texto)">0/<%= cat.max %> selecionadas</span>
            </div>
            <div style="max-height:280px; overflow-y:auto; border:1px solid var(--cinza); border-radius:8px; padding:8px">
              <% selecoes.forEach(function(s) { %>
                <label style="display:flex; align-items:center; gap:8px; padding:4px 6px; border-radius:4px; cursor:pointer; <%= resultados[cat.id] && resultados[cat.id].has(s.id) ? 'background:var(--cinza-claro);font-weight:600' : '' %>">
                  <input type="checkbox" name="<%= cat.id %>" value="<%= s.id %>" onchange="atualizarContador('<%= cat.id %>', <%= cat.max %>)"
                    <%= resultados[cat.id] && resultados[cat.id].has(s.id) ? 'checked' : '' %>>
                  <%= s.nome_pt %>
                </label>
              <% }); %>
            </div>
          <% } else { %>
            <select name="<%= cat.id %>" class="form-control">
              <option value="">— Selecione —</option>
              <% selecoes.forEach(function(s) { %>
                <option value="<%= s.id %>" <%= resultados[cat.id] && resultados[cat.id].has(s.id) ? 'selected' : '' %>>
                  <%= s.nome_pt %>
                </option>
              <% }); %>
            </select>
          <% } %>
        </div>
      </div>
      <div class="text-center mt-2">
        <button type="submit" class="btn btn-sm btn-primary">💾 Salvar <%= cat.nome %></button>
      </div>
    </form>
  <% }); %>
</div>

<script>
function atualizarContador(catId, max) {
  const checkboxes = document.querySelectorAll('input[name="' + catId + '"]:checked');
  const el = document.getElementById('counter-' + catId);
  if (el) el.textContent = checkboxes.length + '/' + max + ' selecionadas';
}
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('[id^="counter-"]').forEach(function(el) {
    var catId = el.id.replace('counter-', '');
    var max = parseInt(el.textContent.split('/')[1], 10);
    atualizarContador(catId, max);
  });
});
</script>
<%- include('partials/footer') %>