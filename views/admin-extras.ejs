<%- include('partials/header', { active: 'admin' }) %>

<%- include('partials/flash') %>

<h1>🏆 Resultados Extras</h1>
<p class="subtitulo">Marque as seleções vencedoras de cada categoria. Os pontos extras serão somados ao ranking automaticamente.</p>

<form method="POST" action="/admin/extras">
  <div class="grid grid-2">
    <% categorias.forEach(function(cat) { %>
      <div class="card">
        <div class="flex-between">
          <h3 style="margin:0"><%= cat.nome %></h3>
          <span class="pontos-badge"><%= cat.pts %> pts</span>
        </div>
        <div class="form-group mt-2" style="margin-bottom:0">
          <% if (multiCats.has(cat.id)) { %>
            <div style="max-height:320px; overflow-y:auto; border:1px solid var(--cinza); border-radius:8px; padding:8px">
              <% selecoes.forEach(function(s) { %>
                <label style="display:flex; align-items:center; gap:8px; padding:4px 6px; border-radius:4px; cursor:pointer; <%= resultados[cat.id] && resultados[cat.id].has(s.id) ? 'background:var(--cinza-claro);font-weight:600' : '' %>">
                  <input type="checkbox" name="<%= cat.id %>" value="<%= s.id %>"
                    <%= resultados[cat.id] && resultados[cat.id].has(s.id) ? 'checked' : '' %>>
                  <%= s.nome_pt %>
                </label>
              <% }); %>
            </div>
          <% } else { %>
            <select name="<%= cat.id %>" class="form-control">
              <option value="">— Selecione —</option>
              <% selecoes.forEach(function(s) { %>
                <option value="<%= s.id %>" <%= resultados[cat.id] && resultados[cat.id].has(s.id) ? 'selected' : '' %>>
                  <%= s.nome_pt %>
                </option>
              <% }); %>
            </select>
          <% } %>
        </div>
      </div>
    <% }); %>
  </div>

  <div class="text-center mt-3 mb-2">
    <button type="submit" class="btn btn-primary btn-lg">💾 Salvar resultados</button>
  </div>
</form>

<%- include('partials/footer') %>
